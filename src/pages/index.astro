---
import ComingSoonPage from "../components/home/ComingSoonPage.astro";
import landingImage from "../assets/landing-image.jpg";
import FestivalArtistsSection from "../components/common/FestivalArtistsSection.astro";
// import LineupSection from "../components/common/LineupSection.astro";
import PartnerSection from "../components/common/PartnerSection.astro";
import SiteFooter from "../components/common/SiteFooter.astro";
import GallerySection from "../components/home/GallerySection.astro";
import LandingSection from "../components/home/LandingSection.astro";
import Layout from "../layouts/Layout.astro";

const showComingSoon = import.meta.env.PUBLIC_SHOW_COMING_SOON === "true";
const eventUrl = new URL("/", Astro.site).toString();
const eventStructuredData = {
	"@type": "MusicEvent",
	"@id": `${eventUrl}#event-2026`,
	name: "Laveno End Of Summer Festival 2026",
	alternateName: "Laveno (End of) Summer Festival 2026",
	description:
		"Festival musicale gratuito a Laveno Mombello con concerti, DJ set, arte e attività sulle rive del Lago Maggiore.",
	url: eventUrl,
	image: [new URL(landingImage.src, Astro.site).toString()],
	startDate: "2026-08-28T17:00:00+02:00",
	endDate: "2026-08-31T01:00:00+02:00",
	eventStatus: "https://schema.org/EventScheduled",
	eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
	inLanguage: "it-IT",
	isAccessibleForFree: true,
	location: {
		"@type": "Place",
		name: "Parco Gaggetto",
		address: {
			"@type": "PostalAddress",
			streetAddress: "Via Gaggetto",
			postalCode: "21014",
			addressLocality: "Laveno-Mombello",
			addressRegion: "VA",
			addressCountry: "IT",
		},
	},
	offers: {
		"@type": "Offer",
		url: eventUrl,
		price: 0,
		priceCurrency: "EUR",
		availability: "https://schema.org/InStock",
	},
	organizer: {
		"@id": new URL("/#organization", Astro.site).toString(),
	},
	performer: ["Sally Cruz", "Marte", "Vaz Tè", "Disme", "Lil Jolie", "Sissi"].map(
		(name) => ({
			"@type": "Person",
			name,
		}),
	),
};
---

<Layout
	showMenu={!showComingSoon}
	structuredData={showComingSoon ? undefined : eventStructuredData}
>
	{
		showComingSoon ? (
			<ComingSoonPage />
		) : (
			<main>
				<LandingSection />
				{/* <LineupSection blendWithPreviousSection /> */}
				<FestivalArtistsSection blendWithPreviousSection />
				<PartnerSection />
				{/* <FestivalMapSection /> */}
				<GallerySection />
				<SiteFooter />
			</main>
		)
	}
</Layout>
