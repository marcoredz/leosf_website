---
import { Icon } from "astro-icon/components";
import SiteFooter from "../components/common/SiteFooter.astro";
import { contactDetails, socials } from "../data/contacts";
import Layout from "../layouts/Layout.astro";
---

<Layout
	title="Contatti | Laveno End Of Summer Festival 2026"
	description="Contatta il Laveno End Of Summer Festival e seguici sui nostri canali social."
>
	<main class="w-full min-w-0 overflow-x-clip">
		<section class="bg-background-dark px-5 pb-14 pt-32 text-background-light sm:px-8 sm:pb-20 sm:pt-36">
			<div class="mx-auto w-full max-w-5xl">
				<p class="font-plex text-sm uppercase leading-tight sm:text-base">
					Laveno End Of Summer Festival
				</p>
				<h1 class="mt-5 font-blur text-[clamp(3.5rem,11vw,8.5rem)] uppercase leading-none">
					Contatti
				</h1>
				<p class="mt-8 max-w-2xl font-plex text-base leading-tight sm:text-lg">
					Scrivici o chiamaci. Siamo qui per rispondere alle tue domande sul festival.
				</p>
			</div>
		</section>

		<section class="bg-background-light px-5 py-14 text-background-dark sm:px-8 sm:py-20">
			<div class="mx-auto w-full min-w-0 max-w-4xl">
				<div class="grid min-w-0 border-t border-background-dark/25 md:grid-cols-2">
					{
						contactDetails.map(({ label, value, href, external }, index) => (
							<address
								class:list={[
									"min-w-0 border-b border-background-dark/25 py-8 not-italic md:min-h-56 md:px-6 md:py-9 lg:px-8",
									index > 0 && "md:border-l",
								]}
							>
								<p class="font-plex text-xs uppercase leading-tight opacity-70 sm:text-sm">
									{String(index + 1).padStart(2, "0")} / {label}
								</p>
								<a
									href={href}
									target={external ? "_blank" : undefined}
									rel={external ? "noreferrer" : undefined}
									class="mt-8 block min-w-0 whitespace-pre-line wrap-anywhere font-blur text-[clamp(1.25rem,2.8vw,2rem)] uppercase leading-tight transition-colors hover:text-leof-burgundy md:whitespace-nowrap md:text-lg lg:text-xl"
								>
									{value}
								</a>
							</address>
						))
					}
				</div>
			</div>
		</section>

		<section class="bg-leof-orange-light px-5 py-14 text-background-dark sm:px-8 sm:py-20">
			<div class="mx-auto grid w-full min-w-0 max-w-5xl gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)] md:items-end">
				<div>
					<p class="font-plex text-xs uppercase leading-tight opacity-75 sm:text-sm">Rimani aggiornato</p>
					<h2 class="mt-3 font-blur text-[clamp(2.75rem,8vw,6rem)] uppercase leading-none">
						Seguici
					</h2>
				</div>

				<nav aria-label="Social" class="grid min-w-0 gap-3 sm:grid-cols-3">
					{
						socials.map(({ label, href, icon }) => (
							<a
								href={href}
								target="_blank"
								rel="noreferrer"
								class="flex items-center justify-between rounded-full border border-background-dark px-5 py-3 font-plex text-sm uppercase transition-colors hover:bg-background-dark hover:text-background-light"
							>
								<span>{label}</span>
								<Icon name={icon} class="h-4 w-4" aria-hidden="true" />
							</a>
						))
					}
				</nav>
			</div>
		</section>

		<SiteFooter />
	</main>
</Layout>
