---
import chicoria from "../assets/chicoria.jpg";
import workshopPostit from "../assets/workshop-postit.jpg";
import popupAvis from "../assets/popup-avis.jpg";
import popupLegambiente from "../assets/popup-legambiente.jpg";
import FestivalMapSection from "../components/common/FestivalMapSection.astro";
import LineupSection from "../components/common/LineupSection.astro";
import PartnerSection from "../components/common/PartnerSection.astro";
import SiteFooter from "../components/common/SiteFooter.astro";
import RulesAccordion from "../components/program/RulesAccordion.astro";
import ProgramCardScroller from "../components/program/ProgramCardScroller.astro";
import ProgramSection from "../components/program/ProgramSection.astro";
import Layout from "../layouts/Layout.astro";

const activities = [
	{ title: "", image: workshopPostit },
	{ title: "Fitness", backgroundClass: "bg-leof-green" },
	{ title: "Talk", backgroundClass: "bg-leof-orange" },
];

const popUps = [
	{ title: "Avis", image: popupAvis },
	{ title: "Legambiente", image: popupLegambiente },
	{ title: "Market", backgroundClass: "bg-leof-purple" },
];

const pastEditions = [
	{ title: "2025", subtitle: "10.000 persone", image: chicoria },
	{ title: "2024", subtitle: "Area live", backgroundClass: "bg-leof-orange" },
	{ title: "2023", subtitle: "Lago e musica", backgroundClass: "bg-leof-green" },
];
---

<Layout
	title="Programma | Laveno End Of Summer Fest 2026"
	description="Programma del Laveno End Of Summer Fest 2026: lineup, mappa, attivita', workshop, pop up, edizioni passate e regolamento."
>
	<main>
		<section class="bg-background-dark px-5 pb-10 pt-32 text-background-light sm:px-8 sm:pb-14 sm:pt-36">
			<div class="mx-auto w-full max-w-5xl text-center">
				<h1 class="font-blur text-[clamp(3.25rem,10vw,8rem)] uppercase leading-none">
					Programma
				</h1>
			</div>
		</section>

		<LineupSection />

		<FestivalMapSection />

		<ProgramSection title="Attivita' e Workshop">
			<p class="mx-auto max-w-2xl text-center font-plex text-sm uppercase leading-tight sm:text-base">
				Spazi dedicati a movimento, creativita' e incontri durante i tre giorni del festival.
			</p>
			<div class="mt-8">
				<ProgramCardScroller items={activities} cardLabel="Attivita' e workshop" />
			</div>
		</ProgramSection>

		<ProgramSection title="Pop Up">
			<p class="mx-auto max-w-2xl text-center font-plex text-sm uppercase leading-tight sm:text-base">
				Progetti, brand e realta' ospiti dentro l'area festival, con corner e iniziative dedicate.
			</p>
			<div class="mt-8">
				<ProgramCardScroller items={popUps} cardLabel="Pop up" />
			</div>
		</ProgramSection>

		<ProgramSection title="Edizioni Passate">
			<ProgramCardScroller items={pastEditions} cardLabel="Edizioni passate" />
		</ProgramSection>

		<RulesAccordion />

		<PartnerSection />

		<SiteFooter />
	</main>
</Layout>
