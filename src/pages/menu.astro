---
import SiteFooter from "../components/common/SiteFooter.astro";
import { drinkMenu, foodMenu, wineMenu } from "../data/menu";
import Layout from "../layouts/Layout.astro";
---

<Layout
	title="Menu | Laveno End Of Summer Festival 2026"
	description="Il menu di cibo e bevande del Laveno End Of Summer Festival 2026."
>
	<main class="w-full min-w-0 overflow-x-clip">
		<section class="bg-leof-orange-light px-5 pb-14 pt-32 text-background-dark sm:px-8 sm:pb-20 sm:pt-36">
			<div class="mx-auto flex w-full max-w-5xl justify-center">
				<h1 class="text-center font-blur text-[clamp(3.0rem,11vw,7rem)] uppercase leading-[0.82]">
					End Of Menu
				</h1>
			</div>
		</section>

		<section class="bg-background-light px-5 py-14 text-background-dark sm:px-8 sm:py-20" aria-labelledby="food-title">
			<div class="mx-auto w-full max-w-5xl">
				<header class="grid gap-5 md:grid-cols-[0.8fr_1.2fr] md:items-end md:gap-10">
					<div>
						<h2 id="food-title" class="mt-3 font-blur text-[clamp(3.5rem,9vw,7rem)] uppercase leading-none">
							Cibo
						</h2>
					</div>
				</header>

				<ul class="mt-10 grid gap-x-10 border-t border-background-dark/25 md:grid-cols-2 md:mt-14" aria-label="Menu del cibo">
					{
						foodMenu.map(({ name, price, promotion }) => (
							<li class="border-b border-background-dark/25 py-5 sm:py-6">
								<div class="flex items-start justify-between gap-4">
									<h3 class="max-w-68 font-blur text-[clamp(1.35rem,3vw,2rem)] uppercase leading-[0.95]">
										{name}
									</h3>
									<span class="shrink-0 font-plex text-[clamp(1.3rem,3vw,1.8rem)] leading-none">
										{price}
									</span>
								</div>
								{promotion && (
									<p class="mt-3 font-bold font-plex text-md uppercase leading-tight text-leof-orange sm:text-md">
										{promotion}
									</p>
								)}
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<section class="bg-leof-purple px-5 py-14 text-background-light sm:px-8 sm:py-20" aria-labelledby="drink-title">
			<div class="mx-auto w-full max-w-5xl">
				<header class="grid gap-5 md:grid-cols-[0.8fr_1.2fr] md:items-end md:gap-10">
					<div>
						<h2 id="drink-title" class="mt-3 font-blur text-[clamp(3.5rem,9vw,7rem)] uppercase leading-none">
							Bere
						</h2>
					</div>
				</header>

				<div class="mt-10 grid gap-x-10 border-t border-background-light/25 md:grid-cols-2 md:mt-14">
					<article class="border-b border-background-light/25 py-5 sm:py-6">
						<div class="flex items-start justify-between gap-4">
							<h3 class="font-blur text-[clamp(1.35rem,3vw,2rem)] uppercase leading-[0.95]">
								{wineMenu.name}
							</h3>
						</div>
						<ul class="mt-5 space-y-3 border-t border-background-light/20 pt-4" aria-label="Prezzi del vino alla spina">
							{
								wineMenu.options.map(({ name, price, note }) => (
									<li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 font-plex text-sm sm:text-base">
										<span>{name}</span>
										<span class="font-plex font-semibold">{price}</span>
										{note && <span class="basis-full text-xs opacity-70">{note}</span>}
									</li>
								))
							}
						</ul>
					</article>

					<ul class="border-b border-background-light/25 md:col-start-2" aria-label="Menu delle bevande">
						{
							drinkMenu.map(({ name, price }) => (
								<li class="border-t border-background-light/25 py-5 first:border-t-0 sm:py-6">
									<div class="flex items-start justify-between gap-4">
										<h3 class="max-w-68 font-blur text-[clamp(1.35rem,3vw,2rem)] uppercase leading-[0.95]">
											{name}
										</h3>
										<span class="shrink-0 font-plex text-[clamp(1.3rem,3vw,1.8rem)] leading-none">
											{price}
										</span>
									</div>
								</li>
							))
						}
					</ul>
				</div>

				<p class="mt-8 font-plex text-xs uppercase leading-tight opacity-70 sm:text-sm">
					Prezzi espressi in euro · La cauzione viene restituita alla riconsegna della caraffa.
				</p>
			</div>
		</section>

		<SiteFooter />
	</main>
</Layout>
