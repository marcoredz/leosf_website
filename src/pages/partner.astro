---
import { Image } from "astro:assets";
import SiteFooter from "../components/common/SiteFooter.astro";
import { partners } from "../data/partners";
import Layout from "../layouts/Layout.astro";
---

<Layout
	title="Partner | Laveno End Of Summer Festival 2026"
	description="Resoconto completo dei partner del Laveno End Of Summer Festival 2026."
>
	<main>
		<section class="bg-background-dark px-5 pb-12 pt-32 text-background-light sm:px-8 sm:pb-16 sm:pt-36">
			<div class="mx-auto w-full max-w-5xl">
				<p class="font-plex text-sm uppercase leading-tight sm:text-base">
					Laveno End Of Summer Festival
				</p>
				<h1 class="mt-5 font-blur text-[clamp(3.25rem,10vw,8rem)] uppercase leading-none">
					Partner
				</h1>
				<p class="mt-7 max-w-2xl font-plex text-base uppercase leading-tight sm:text-lg">
					Il resoconto completo delle realta' che sostengono il festival.
				</p>
			</div>
		</section>

		<section class="bg-background-light px-5 py-12 text-background-dark sm:px-8 sm:py-16">
			<div class="mx-auto w-full max-w-5xl">
				<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
					{
						partners.map(({ name, role, logo }) => (
							<article class="flex min-h-64 flex-col justify-between rounded bg-white p-5">
								<div class="grid min-h-32 place-items-center">
									<Image
										src={logo}
										alt={name}
										width={260}
										format="webp"
										quality={90}
										class={
											name.includes("Noise")
												? "max-h-40 w-auto max-w-full object-contain"
												: "max-h-24 w-auto max-w-full object-contain"
										}
										loading="lazy"
										decoding="async"
									/>
								</div>
								<div class="mt-6 border-t border-background-dark/15 pt-4">
									<h2 class="font-blur text-3xl uppercase leading-none">
										{name}
									</h2>
									<p class="mt-3 font-plex text-xs uppercase leading-tight opacity-75">
										{role}
									</p>
								</div>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<SiteFooter />
	</main>
</Layout>
