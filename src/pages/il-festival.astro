---
import { Image, getImage } from "astro:assets";
import festivalHero from "../../references/FOTO/IMG_1688.JPG";
import teamPhoto from "../../references/FOTO/DSC_0149.JPG";
import SiteFooter from "../components/common/SiteFooter.astro";
import Layout from "../layouts/Layout.astro";

const sections = [
	{
		id: "chi-siamo",
		title: "Chi siamo",
		background: "bg-background-light",
		textColor: "text-background-dark",
		body: `Un evento che vive grazie alla collaborazione di tante realtà locali:
associazioni e attività, unite dal desiderio di offrire ai giovani
un’esperienza di incontro, musica e creatività
sulle rive del Lago Maggiore`,
	},
	{
		id: "mission",
		title: "Mission",
		background: "bg-leof-purple",
		textColor: "text-background-light",
		body: `Dare vita a un’esperienza che unisce musica, arte e sport
in un abbraccio collettivo, aperto a tutti. Laveno (end of) Summer
è energia, libertà e ispirazione, un festival gratuito, sostenibile
e pieno di vita, dove ogni estate lascia un segno.
“Pensare globale, agire locale.”
A Laveno l’arte diventa il linguaggio che ci unisce.`,
	},
	{
		id: "vision",
		title: "Vision",
		background: "bg-leof-orange-light",
		textColor: "text-background-dark",
		body: `Far vivere al Lago Maggiore la magia di un grande evento nazionale,
dove il paesaggio diventa palco e la comunità diventa pubblico.
Un festival che racconta la bellezza del nostro territorio
e la voglia di creare, sognare e condividere`,
	},
];

const heroPlaceholder = await getImage({
	src: festivalHero,
	width: 24,
	quality: 10,
	format: "avif",
});

const teamPlaceholder = await getImage({
	src: teamPhoto,
	width: 24,
	quality: 10,
	format: "avif",
});
---

<Layout
	title="Il Festival | Laveno End Of Summer Fest 2026"
	description="Chi siamo, mission, vision e team del Laveno End Of Summer Fest."
>
	<main>
		<section class="relative flex min-h-[86svh] overflow-hidden bg-background-dark px-5 pb-16 pt-32 text-background-light sm:px-8 sm:pb-20 sm:pt-36">
			<div
				class="absolute inset-0 scale-105"
				style={`background-image: url(${heroPlaceholder.src}); background-size: cover; background-position: center; filter: blur(8px);`}
				aria-hidden="true"
			>
				<Image
					src={festivalHero}
					alt=""
					widths={[640, 1024, 1536, 2048]}
					sizes="100vw"
					format="avif"
					quality={5}
					class="h-full w-full object-cover"
					loading="eager"
				/>
			</div>
			<div class="absolute inset-0 bg-background-dark/45" aria-hidden="true"></div>

			<div class="relative z-10 mx-auto flex w-full max-w-5xl flex-col justify-end">
				<p class="font-plex text-sm uppercase leading-tight sm:text-base">
					Laveno End Of Summer Fest
				</p>
				<h1 class="mt-5 max-w-4xl font-blur text-[clamp(3.5rem,11vw,8.5rem)] uppercase leading-none">
					Il Festival
				</h1>
				<p class="mt-8 max-w-2xl font-plex text-base  leading-tight sm:text-lg">
					Musica, arte e comunità sulle rive del Lago Maggiore.
				</p>
			</div>
		</section>

		{
			sections.map(({ id, title, background, textColor, body }, index) => (
				<section id={id} class:list={[background, textColor, "px-5 py-14 sm:px-8 sm:py-20"]}>
					<div
						class:list={[
							"mx-auto grid w-full max-w-5xl gap-8 lg:grid-cols-[0.78fr_1.22fr] lg:items-start lg:gap-14",
							index % 2 === 1 ? "lg:grid-cols-[1.22fr_0.78fr]" : "",
						]}
					>
						<header class:list={[index % 2 === 1 ? "lg:order-2" : ""]}>
							<p class="font-plex text-xs uppercase leading-tight opacity-80 sm:text-sm">
								{String(index + 1).padStart(2, "0")}
							</p>
							<h2 class="mt-3 font-blur text-[clamp(2.7rem,8vw,6rem)] uppercase leading-none">
								{title}
							</h2>
						</header>

						<p class="max-w-3xl whitespace-pre-line font-plex text-[clamp(1rem,2.1vw,1.45rem)] leading-tight">
							{body}
						</p>
					</div>
				</section>
			))
		}

		<section id="team" class="bg-background-light px-5 py-14 text-background-dark sm:px-8 sm:py-20">
			<div class="mx-auto grid w-full max-w-5xl gap-8 lg:grid-cols-[0.85fr_1.15fr] lg:items-center lg:gap-14">
				<header>
					<p class="font-plex text-xs uppercase leading-tight opacity-80 sm:text-sm">
						04
					</p>
					<h2 class="mt-3 font-blur text-[clamp(2.7rem,8vw,6rem)] uppercase leading-none">
						Team
					</h2>
					<p class="mt-6 max-w-xl font-plex text-base uppercase leading-tight sm:text-lg">
						In aggiornamento.
					</p>
				</header>

				<div
					class="overflow-hidden rounded bg-background-dark"
					style={`background-image: url(${teamPlaceholder.src}); background-size: cover; background-position: center;`}
				>
					<Image
						src={teamPhoto}
						alt="Persone durante il Laveno End Of Summer Fest"
						widths={[480, 720, 960, 1280]}
						sizes="(max-width: 1024px) 100vw, 48vw"
						format="avif"
						quality={40}
						class="aspect-4/3 h-full w-full object-cover"
						loading="lazy"
						decoding="async"
					/>
				</div>
			</div>
		</section>

		<SiteFooter />
	</main>
</Layout>
