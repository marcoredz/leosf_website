---
import { Image, getImage } from "astro:assets";
import chicoria from "../assets/artists/chicoria2.jpg";
import giaime2024 from "../assets/artists/giaime2024.jpg";
import elea2023 from "../assets/artists/elea2023.jpg";
import leosf22 from "../assets/leosf22.jpeg";
import festivalHero from "../assets/festival.jpg";
import teamPhoto from "../assets/team.jpeg";
import PastEditionDetailCard from "../components/program/PastEditionDetailCard.astro";
import ProgramCardScroller from "../components/program/ProgramCardScroller.astro";
import ProgramSection from "../components/program/ProgramSection.astro";
import RulesAccordion from "../components/program/RulesAccordion.astro";
import SiteFooter from "../components/common/SiteFooter.astro";
import Layout from "../layouts/Layout.astro";

const sections = [
	{
		id: "chi-siamo",
		title: "Chi siamo",
		background: "bg-background-light",
		textColor: "text-background-dark",
		body: `Un evento che vive grazie alla collaborazione di tante realtà locali:
associazioni e attività, unite dal desiderio di offrire ai giovani
un’esperienza di incontro, musica e creatività
sulle rive del Lago Maggiore`,
	},
	{
		id: "mission",
		title: "Mission",
		background: "bg-leof-purple",
		textColor: "text-background-light",
		body: `Dare vita a un’esperienza che unisce musica, arte e sport
in un abbraccio collettivo, aperto a tutti. Laveno (end of) Summer
è energia, libertà e ispirazione, un festival gratuito, sostenibile
e pieno di vita, dove ogni estate lascia un segno.
“Pensare globale, agire locale.”
A Laveno l’arte diventa il linguaggio che ci unisce.`,
	},
	{
		id: "vision",
		title: "Vision",
		background: "bg-leof-orange-light",
		textColor: "text-background-dark",
		body: `Far vivere al Lago Maggiore la magia di un grande evento nazionale,
dove il paesaggio diventa palco e la comunità diventa pubblico.
Un festival che racconta la bellezza del nostro territorio
e la voglia di creare, sognare e condividere`,
	},
];

const heroPlaceholder = await getImage({
	src: festivalHero,
	width: 24,
	quality: 10,
	format: "avif",
});

const pastEditions = [
	{
		title: "2025",
		detailTitle: "Più forti del maltempo",
		description: "L’edizione 2025 racconta la forza di una comunità che non si ferma davanti agli imprevisti. Dopo l’annullamento della prima giornata per il maltempo, volontari e organizzatori hanno rimesso in piedi il festival, dando vita a due giornate intense di musica, sport, creatività e incontri. Pop-up, mercatini, laboratori, contest per giovani artisti e nuove iniziative dedicate alla sostenibilità hanno portato al Gaggetto oltre 10.000 persone.",
		attendance: "10.000+",
		peak: "6.000",
		image: chicoria,
		imageAlt: "Un momento dell’edizione 2025 del festival",
		dialogId: "past-edition-2025",
		accentClass: "text-leof-burgundy",
		visualClass: "bg-leof-burgundy",
	},
	{
		title: "2024",
		detailTitle: "L’esplosione",
		description: "Tre giornate, 8.000 presenze e un picco di 4.000 persone: nel 2024 il Laveno (End of) Summer Festival diventa un’esperienza a tutto tondo. Alla musica live si affiancano workshop, teatro, yoga, fitness, mercatini, pop-up store e collaborazioni con brand locali. Il festival si apre a nuovi linguaggi e trasforma il Parco Gaggetto in un piccolo villaggio creativo, vivo dal pomeriggio fino a notte.",
		attendance: "8.000",
		peak: "4.000",
		image: giaime2024,
		imageAlt: "Giaime 2024",
		backgroundClass: "bg-leof-orange",
		dialogId: "past-edition-2024",
		accentClass: "text-leof-orange",
		visualClass: "bg-leof-orange",
	},
	{
		title: "2023",
		detailTitle: "La conferma",
		description: "Nel 2023 il festival amplia il proprio respiro: tre giornate al Gaggetto, oltre 2.000 presenze e un pubblico sempre più coinvolto. La proposta si rafforza con concerti e dj set, tornei sportivi e una rete crescente di volontari e partner del territorio. È l’anno in cui il festival trova la sua identità: un luogo di espressione per i giovani, ma pensato per tutta la comunità.",
		attendance: "2.000",
		peak: "1.000",
		image: elea2023,
		imageAlt: "Un momento dell’edizione 2023 del festival",
		dialogId: "past-edition-2023",
		accentClass: "text-leof-purple",
		visualClass: "bg-leof-purple",
	},
	{
		title: "2022",
		detailTitle: "La prima luce",
		description: "Tutto è iniziato qui. Due giornate, 800 presenze e un’idea semplice ma potente: creare uno spazio in cui i giovani potessero incontrarsi, suonare, partecipare e vivere il lago in modo nuovo. Tra contest per artisti emergenti, musica live, dj set, beach volley e stand gastronomico, il Parco Gaggetto ha acceso le prime luci di una storia appena cominciata.",
		attendance: "800",
		peak: "500",
		image: leosf22,
		imageAlt: "Un momento della prima edizione del festival nel 2022",
		dialogId: "past-edition-2022",
		accentClass: "text-leof-green",
		visualClass: "bg-leof-green",
	},
];

---

<Layout
	title="Il Festival | Laveno End Of Summer Festival 2026"
	description="Chi siamo, mission, vision, edizioni passate e regolamento del Laveno End Of Summer Festival."
>
	<main>
		<section class="relative flex min-h-[60svh] overflow-hidden bg-background-dark px-5 pb-16 pt-32 text-background-light sm:px-8 sm:pb-20 sm:pt-36">
			<div
				class="absolute inset-0 scale-105"
				style={`background-image: url(${heroPlaceholder.src}); background-size: cover; background-position: center; filter: blur(8px);`}
				aria-hidden="true"
			>
				<Image
					src={festivalHero}
					alt=""
					widths={[640, 1024, 1536, 2048]}
					sizes="100vw"
					format="avif"
					quality={5}
					class="h-full w-full object-cover"
					loading="eager"
				/>
			</div>
			<div class="absolute inset-0 bg-background-dark/45" aria-hidden="true"></div>

			<div class="relative z-10 mx-auto flex w-full max-w-5xl flex-col justify-end">
				<p class="font-plex text-sm uppercase leading-tight sm:text-base">
					Laveno End Of Summer Festival
				</p>
				<h1 class="mt-5 max-w-4xl font-blur text-[clamp(3.5rem,11vw,8.5rem)] uppercase leading-none">
					Il Festival
				</h1>
				<p class="mt-8 max-w-2xl font-plex text-base  leading-tight sm:text-lg">
					Musica, arte e comunità sulle rive del Lago Maggiore.
				</p>
			</div>
		</section>

		{
			sections.map(({ id, title, background, textColor, body }, index) => (
				<section id={id} class:list={[background, textColor, "px-5 py-14 sm:px-8 sm:py-20"]}>
					<div
						class:list={[
							"mx-auto grid w-full max-w-5xl gap-8 lg:grid-cols-[0.78fr_1.22fr] lg:items-start lg:gap-14",
							index % 2 === 1 ? "lg:grid-cols-[1.22fr_0.78fr]" : "",
						]}
					>
						<header class:list={[index % 2 === 1 ? "lg:order-2" : ""]}>
							<p class="font-plex text-xs uppercase leading-tight opacity-80 sm:text-sm">
								{String(index + 1).padStart(2, "0")}
							</p>
							<h2 class="mt-3 font-blur text-[clamp(2.7rem,8vw,6rem)] uppercase leading-none">
								{title}
							</h2>
						</header>

						<p class="max-w-3xl whitespace-pre-line font-plex text-[clamp(1rem,2.1vw,1.45rem)] leading-tight">
							{body}
						</p>
					</div>
				</section>
			))
		}

		<ProgramSection title="Edizioni Passate">
			<ProgramCardScroller items={pastEditions} cardLabel="Edizioni passate" />

			{
				pastEditions.map((edition) => (
					<PastEditionDetailCard
						dialogId={edition.dialogId}
						year={edition.title}
						title={edition.detailTitle}
						description={edition.description}
						attendance={edition.attendance}
						peak={edition.peak}
						image={edition.image}
						imageAlt={edition.imageAlt}
						accentClass={edition.accentClass}
						visualClass={edition.visualClass}
					/>
				))
			}
		</ProgramSection>

		<RulesAccordion />

		<SiteFooter />
	</main>
</Layout>
