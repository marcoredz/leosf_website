---
import { Image, getImage } from "astro:assets";
import EtiforCarousel from "../components/EtiforCarousel.astro";
import SiteFooter from "../components/common/SiteFooter.astro";
import Layout from "../layouts/Layout.astro";
import aerialForest from "../assets/aerial-forest.jpeg";
import tree from "../assets/tree.png";
import leafSketch from "../assets/ui/leaf-sketch.png";
import dropSketch from "../assets/ui/drop-sketch.png";
import plantSketch from "../assets/ui/plant-sketch.png";
import mountainSketch from "../assets/ui/mountain-sketch.png";
import treeLifesteps from "../assets/ui/tree-lifesteps.png";
import parcoTicinoAerial from "../assets/parco-lombardo-valle-ticino/parco-ticino-1.jpg";
import parcoTicino1 from "../assets/parco-lombardo-valle-ticino/wownature-parco-lombardo-del-ticino-05-04-25-hd-1.jpg";
import parcoTicino3 from "../assets/parco-lombardo-valle-ticino/wownature-parco-lombardo-del-ticino-05-04-25-hd-3.jpg";
import parcoTicino4 from "../assets/parco-lombardo-valle-ticino/parco-ticino-4.jpg";
import parcoTicino5 from "../assets/parco-lombardo-valle-ticino/parco-ticino-5.jpg";
import plantingCloseup from "../assets/parco-lombardo-valle-ticino/wownature-parco-lombardo-del-ticino-05-04-25-hd-15.jpg";
import parcoTicino8 from "../assets/parco-lombardo-valle-ticino/wownature-parco-lombardo-del-ticino-05-04-25-hd-8.jpg";
import parcoTicino18 from "../assets/parco-lombardo-valle-ticino/wownature-parco-lombardo-del-ticino-05-04-25-hd-18.jpg";
import etiforLogo from "../assets/parco-lombardo-valle-ticino/etifor-logo.png";
import wownatureLogo from "../assets/parco-lombardo-valle-ticino/wownature-logo.png";

const heroPlaceholder = await getImage({
	src: aerialForest,
	width: 24,
	quality: 10,
	format: "avif",
});

const approachSteps = [
	{ title: "Misuriamo", text: "Analizziamo l'impatto del festival." },
	{ title: "Riduciamo", text: "Riduciamo consumi, rifiuti e materiali." },
	{ title: "Rigeneriamo", text: "Sosteniamo progetti di tutela ambientale." },
	{ title: "Coinvolgiamo", text: "Partner, pubblico e territorio." },
];

const goals = [
	"Misurare l'impronta ambientale dell'evento",
	"Incrementare la raccolta differenziata",
	"Ridurre l'utilizzo di materiali monouso",
	"Favorire la mobilità sostenibile del pubblico",
	"Coinvolgere sponsor e fornitori nel percorso",
	"Sostenere un progetto WOWnature con obiettivi verificabili",
];

const loopingGoals = [goals.at(-1), ...goals, goals[0]];

const impacts = [
	{ title: "Biodiversità", image: leafSketch },
	{ title: "Acqua", image: dropSketch },
	{ title: "Suolo", image: plantSketch },
	{ title: "Territorio", image: mountainSketch },
];

const carouselPhotos = [
	{ src: parcoTicino1, alt: "Il Parco Lombardo della Valle del Ticino" },
	{ src: plantingCloseup, alt: "Un giovane albero appena piantato" },
	{ src: parcoTicino4, alt: "Persone impegnate a piantare alberi" },
	{ src: parcoTicino3, alt: "Persone in cammino nel bosco" },
	{ src: parcoTicino5, alt: "Alberi piantati nel bosco" },
	{ src: parcoTicino8, alt: "Un incontro nel verde del Parco del Ticino" },
	{ src: parcoTicino18, alt: "Un'area del Parco del Ticino" },
];
---

<Layout
	title="Sostenibilità | Laveno End Of Summer Fest 2026"
	description="Il percorso di sostenibilità del Laveno End Of Summer Fest insieme a Etifor e WOWnature."
>
	<main class="sustainability-page">
		<section class="sustainability-hero" aria-labelledby="sustainability-title">
			<div
				class="sustainability-hero-image"
				style={`background-image: url(${heroPlaceholder.src});`}
				aria-hidden="true"
			>
				<Image
					src={aerialForest}
					alt=""
					widths={[640, 1024, 1536, 2048]}
					sizes="100vw"
					format="avif"
					quality={68}
					class="h-full w-full object-cover"
					loading="eager"
				/>
			</div>
			<div class="sustainability-hero-shade" aria-hidden="true"></div>
			<div class="sustainability-hero-copy">
				<h1 id="sustainability-title">Sostenibilità</h1>
				<p>Un festival che si prende<br />cura del territorio</p>
			</div>
			<a
				href="#sustainability-content"
				class="sustainability-scroll-indicator"
				aria-label="Scopri il nostro approccio"
			>
				V
			</a>
			<div class="sustainability-forest-blend" aria-hidden="true"></div>
		</section>

		<section id="sustainability-content" class="approach-section" aria-labelledby="approach-title">
			<div class="content-shell">
				<h2 id="approach-title">Il nostro approccio</h2>
				<div class="approach-intro">
					<h3>Un percorso, non un traguardo</h3>
					<p>
						La sostenibilità non è un risultato, ma un processo di miglioramento continuo.
					</p>
				</div>

				<ol class="approach-list">
					{approachSteps.map(({ title, text }) => (
						<li class="approach-item">
							<h3>{title}</h3>
							<p>{text}</p>
						</li>
					))}
				</ol>
			</div>
		</section>

		<div class="sustainability-green-field">
			<section class="partners-section" aria-labelledby="partners-title">
				<div class="etifor-tree-left" aria-hidden="true">
					<Image
						src={tree}
						alt=""
						width={1500}
						quality={75}
						class="etifor-tree-left-image"
						loading="lazy"
					/>
				</div>

				<div class="etifor-tree-right" aria-hidden="true">
					<Image
						src={tree}
						alt=""
						width={1500}
						quality={75}
						class="etifor-tree-right-image"
						loading="lazy"
					/>
				</div>

				<div class="content-shell partners-heading">
					<h2 id="partners-title">Etifor e WOWnature</h2>
					<div class="partner-logo-placeholders" aria-label="Loghi Etifor e WOWnature">
						<div class="etifor-logo">
							<Image src={etiforLogo} alt="Etifor" width={300} quality={10} loading="lazy" />
						</div>
						<div class="wownature-logo">
							<Image src={wownatureLogo} alt="WOWnature" width={300} quality={10} loading="lazy" />
						</div>
					</div>
				</div>

				<EtiforCarousel photos={carouselPhotos} />

				<div class="content-shell partner-descriptions">
					<p>
						Collaboriamo con Etifor e WOWnature per misurare gli impatti del festival,
						definire obiettivi concreti e sostenere progetti di rigenerazione della natura.
					</p>
					<p>
						<strong>Etifor</strong> è una società benefit, spin-off dell'Università di Padova e B
						Corp certificata, specializzata nella valorizzazione del capitale naturale.
					</p>
					<p>
						<strong>WOWnature</strong> realizza progetti di tutela e ripristino degli ecosistemi,
						coinvolgendo cittadini, imprese ed enti pubblici.
					</p>
				</div>
			</section>

			<section class="project-section" aria-labelledby="project-title">
				<div class="content-shell project-copy">
					<h2 id="project-title">Il progetto</h2>
					<p>
						Sosteniamo un progetto di tutela del <strong>Parco Lombardo della Valle del Ticino</strong>,
						uno dei principali <strong>corridoi ecologici</strong> d'Europa e parte della Riserva
						della Biosfera <strong>UNESCO</strong> Ticino Val Grande Verbano.
					</p>
					<p>
						Un'iniziativa che contribuisce a proteggere biodiversità, suolo, risorse idriche e
						paesaggio, rafforzando il legame tra il festival e il territorio che lo ospita.
					</p>

					<ul class="impact-list" aria-label="Aree di impatto del progetto">
						{impacts.map(({ title, image }) => (
							<li>
								<Image src={image} alt="" width={80} quality={10} class="impact-icon" loading="lazy" />
								<span>{title}</span>
							</li>
						))}
					</ul>
				</div>
			</section>

			<section class="goals-section" aria-labelledby="goals-title">
				<h2 id="goals-title">Obiettivi 2026</h2>
				<div class="goals-carousel" data-goals-carousel>
					<ul
						class="goals-track"
						tabindex="0"
						aria-label="Obiettivi di sostenibilità 2026"
						data-goals-track
					>
						{loopingGoals.map((goal, index) => {
							const isClone = index === 0 || index === loopingGoals.length - 1;
							const goalIndex = index === 0 ? goals.length - 1 : index === loopingGoals.length - 1 ? 0 : index - 1;

							return (
								<li
									class="goal-slide"
									data-goal-slide
									data-goal-index={goalIndex}
									aria-hidden={isClone ? "true" : undefined}
								>
									<p>{goal}</p>
								</li>
							);
						})}
					</ul>
					<div class="goals-dots" aria-label="Seleziona un obiettivo">
						{goals.map((_, index) => (
							<button
								type="button"
								class:list={["goals-dot", { "is-active": index === 0 }]}
								aria-label={`Vai all'obiettivo ${index + 1}`}
								aria-current={index === 0 ? "true" : undefined}
								data-goal-dot={index}
							></button>
						))}
					</div>
				</div>
			</section>

			<section class="change-section" aria-labelledby="change-title">
				<div class="content-shell change-copy">
					<h2 id="change-title">Diventa parte<br />del cambiamento</h2>
					<h3>Ogni scelta conta</h3>
					<p>
						Partecipa al festival in modo responsabile, sostieni i progetti ambientali e
						aiutaci a costruire un evento sempre più sostenibile.
					</p>
					<a
						href="https://www.etifor.com/it/"
						target="_blank"
						rel="noreferrer"
						class="donation-link"
					>
						DONA UN ALBERO
					</a>
					<div class="change-icons" aria-label="Crescita degli alberi">
						<Image
							src={treeLifesteps}
							alt="Crescita di un albero in quattro fasi"
							width={600}
							quality={72}
							loading="lazy"
						/>
					</div>
				</div>

				<figure class="ticino-image">
					<Image
						src={parcoTicinoAerial}
						alt="Veduta aerea del Parco Lombardo della Valle del Ticino"
						width={1200}
						format="webp"
						quality={50}
						loading="lazy"
					/>
				</figure>
			</section>
		</div>
	</main>
	<SiteFooter variant="sustainability" />
</Layout>

<script>
	const goalsTrack = document.querySelector<HTMLElement>("[data-goals-track]");
	const goalSlides = goalsTrack?.querySelectorAll<HTMLElement>("[data-goal-slide]");
	const goalDots = document.querySelectorAll<HTMLButtonElement>("[data-goal-dot]");

	if (goalsTrack && goalSlides?.length) {
		let frameId = 0;
		const firstGoal = goalSlides[1];

		const centerSlide = (slide: HTMLElement, behavior: ScrollBehavior = "smooth") => {
			goalsTrack.scrollTo({
				left: slide.offsetLeft - (goalsTrack.clientWidth - slide.clientWidth) / 2,
				behavior,
			});
		};

		const updateActiveGoal = () => {
			const trackCenter = goalsTrack.scrollLeft + goalsTrack.clientWidth / 2;
			let closestSlide = goalSlides[0];
			let closestDistance = Number.POSITIVE_INFINITY;

			goalSlides.forEach((slide) => {
				const slideCenter = slide.offsetLeft + slide.offsetWidth / 2;
				const distance = Math.abs(slideCenter - trackCenter);

				if (distance < closestDistance) {
					closestSlide = slide;
					closestDistance = distance;
				}
			});

			const activeIndex = Number(closestSlide.dataset.goalIndex ?? 0);
			goalSlides.forEach((slide) => slide.classList.toggle("is-active", slide === closestSlide));
			goalDots.forEach((dot, index) => {
				const isActive = index === activeIndex;
				dot.classList.toggle("is-active", isActive);
				dot.toggleAttribute("aria-current", isActive);
			});
		};

		window.requestAnimationFrame(() => {
			centerSlide(firstGoal, "auto");
			updateActiveGoal();
		});

		goalsTrack.addEventListener(
			"scroll",
			() => {
				window.cancelAnimationFrame(frameId);
				frameId = window.requestAnimationFrame(updateActiveGoal);
			},
			{ passive: true },
		);

		goalDots.forEach((dot, index) => {
			dot.addEventListener("click", () => centerSlide(goalSlides[index + 1]));
		});
	}
</script>

<style>
	.sustainability-page {
		--page-light: #e0dddd;
		--page-green: #4a9936;
		--page-ink: #2f2122;
		--page-padding: clamp(1.25rem, 5vw, 5rem);
		color: var(--page-ink);
		background: var(--page-light);
	}

	.content-shell {
		width: min(100%, 78rem);
		margin-inline: auto;
		padding-inline: var(--page-padding);
	}

	.sustainability-hero {
		position: relative;
		display: grid;
		min-height: max(48rem, 96svh);
		place-items: center;
		overflow: hidden;
		background: #17341c;
	}

	.sustainability-hero-image,
	.sustainability-hero-shade,
	.sustainability-forest-blend {
		position: absolute;
		inset: 0;
	}

	.sustainability-hero-image {
		background-position: center;
		background-size: cover;
		transform: scale(1.015);
	}

	.sustainability-hero-image img {
		display: block;
	}

	.sustainability-hero-shade {
		background:
			radial-gradient(circle at 50% 40%, transparent 0%, rgb(5 24 10 / 0.08) 50%, rgb(4 18 8 / 0.25) 100%),
			linear-gradient(to bottom, rgb(0 0 0 / 0.08), transparent 60%);
	}

	.sustainability-forest-blend {
		top: auto;
		height: clamp(19rem, 48vw, 34rem);
		background: linear-gradient(
			to bottom,
			transparent 0%,
			rgb(224 221 221 / 0.12) 22%,
			rgb(224 221 221 / 0.74) 68%,
			var(--page-light) 91%
		);
		pointer-events: none;
	}

	.sustainability-hero-copy {
		position: relative;
		z-index: 2;
		align-self: start;
		width: 100%;
		padding: clamp(16rem, 34vh, 20rem) 1.25rem 0;
		color: #fff;
		text-align: center;
		text-shadow: 0 0.18rem 0.8rem rgb(0 0 0 / 0.35);
	}

	.sustainability-hero-copy h1 {
		margin: 0;
		font-family: var(--font-blur);
		font-size: clamp(2.8rem, 12vw, 8rem);
		line-height: 0.86;
		text-transform: uppercase;
	}

	.sustainability-hero-copy p {
		margin: 1.15rem 0 0;
		font-family: var(--font-plex);
		font-size: clamp(0.78rem, 3.6vw, 1.2rem);
		font-weight: 700;
		line-height: 1.3;
	}

	.sustainability-scroll-indicator {
		position: absolute;
		bottom: 9%;
		left: 50%;
		z-index: 3;
		display: grid;
		width: 3rem;
		height: 3rem;
		place-items: center;
		color: var(--page-green);
		font-family: var(--font-blur);
		font-size: 3rem;
		line-height: 1;
		text-decoration: none;
		transform: translateX(-50%) scaleX(0.82);
		transition: transform 180ms ease;
	}

	.sustainability-scroll-indicator:hover {
		transform: translate(-50%, 0.25rem) scaleX(0.82);
	}

	.sustainability-scroll-indicator:focus-visible,
	.donation-link:focus-visible,
	.goals-dot:focus-visible {
		outline: 3px solid currentColor;
		outline-offset: 4px;
	}

	.approach-section {
		position: relative;
		z-index: 2;
		margin-top: -1px;
		padding: 4.75rem 0 5.3rem;
		background: var(--page-light);
	}

	.approach-section h2,
	.partners-section h2,
	.project-section h2,
	.goals-section h2 {
		margin: 0;
		font-family: var(--font-poppins);
		font-weight: 700;
	}

	.approach-section h2 {
		color: var(--page-green);
		font-size: 32px;
		line-height: 1;
	}

	.approach-intro {
		margin-top: 1.55rem;
	}

	.approach-intro h3,
	.approach-item h3 {
		margin: 0;
		font-family: var(--font-poppins);
		font-weight: 700;
	}

	.approach-intro h3 {
		font-size: 14px;
		line-height: 1.2;
	}

	.approach-intro p,
	.approach-item p {
		margin: 0.42rem 0 0;
		font-size: 14px;
		line-height: 1.34;
	}

	.approach-list {
		display: grid;
		gap: 1.35rem;
		margin: 2.75rem 0 0;
		padding: 0;
		list-style: none;
	}

	.approach-item h3 {
		font-size: 14px;
		line-height: 1.15;
	}

	.sustainability-green-field {
		position: relative;
		overflow: hidden;
		background: var(--page-green);
	}

	.partners-section,
	.project-section,
	.goals-section,
	.change-section,
	.ticino-image {
		position: relative;
		z-index: 1;
	}

	.partners-section {
		isolation: isolate;
		z-index: 2;
		padding: 2.6rem 0 4.7rem;
		color: var(--page-light);
		text-align: center;
	}

	.partners-section h2 {
		position: relative;
		z-index: 2;
		color: #fff;
		font-size: clamp(1.75rem, 7.5vw, 4.5rem);
		line-height: 1;
	}

	.partner-logo-placeholders {
		position: relative;
		z-index: 2;
		display: flex;
		min-height: 2.6rem;
		align-items: center;
		justify-content: center;
		gap: 1.35rem;
		margin-top: 0.7rem;
		color: rgb(255 255 255 / 0.78);
	}

	.etifor-logo {
		width: clamp(9rem, 28vw, 15rem);
	}

	.etifor-logo img {
		display: block;
		width: 100%;
		height: auto;
		filter: brightness(0) invert(1);
	}

	.wownature-logo {
		width: clamp(7rem, 22vw, 12rem);
	}

	.wownature-logo img {
		display: block;
		width: 100%;
		height: auto;
	}

	/* La disposizione e il ritaglio degli alberi restano quelli già presenti. */
	.etifor-tree-left,
	.etifor-tree-right {
		position: absolute;
		z-index: 10;
		width: min(44vw, 36rem);
		height: max(34rem, 119vw);
		overflow: hidden;
		pointer-events: none;
	}

	.etifor-tree-left {
		top: -8rem;
		left: -6rem;
	}

	.etifor-tree-right {
		top: 40rem;
		right: -4rem;
	}

	.etifor-tree-left-image,
	.etifor-tree-right-image {
		position: absolute;
		top: 0;
		z-index: 1;
		width: max(42rem, 150vw);
		max-width: none;
		height: auto;
	}

	.etifor-tree-left-image {
		left: calc(100% - max(42rem, 150vw));
	}

	.etifor-tree-right-image {
		left: 0;
	}

	.partner-descriptions {
		display: grid;
		gap: 1.10rem;
		padding-top: 2rem;
		color: white;
		text-align: left;
	}

	.partner-descriptions p {
		max-width: 44rem;
		margin: 0;
		font-size: 14px;
		line-height: 1.34;
	}

	.partner-descriptions strong {
		color: white;
		font-family: var(--font-poppins);
		font-size: 14px;
		font-weight: 700;
	}

	.project-section {
		padding: 6.7rem 0 4.4rem;
		background: var(--page-light);
	}

	.project-copy {
		max-width: 47rem;
		text-align: center;
	}

	.project-section h2 {
		color: var(--page-green);
		font-size: clamp(2rem, 8.8vw, 4.6rem);
		line-height: 1;
	}

	.project-copy > p {
		margin: 1.55rem auto 0;
		font-size: 14px;
		line-height: 1.35;
	}

	.project-copy > p + p {
		margin-top: 1.7rem;
	}

	.project-copy strong {
		font-family: var(--font-plex);
		font-weight: 700;
	}

	.impact-list {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.55rem;
		margin: 3rem 0 0;
		padding: 0;
		color: var(--page-green);
		list-style: none;
	}

	.impact-list li {
		display: grid;
		justify-items: center;
		gap: 0.45rem;
	}

	.impact-icon {
		display: block;
		width: clamp(2.2rem, 10vw, 3.6rem);
		height: clamp(2.5rem, 11vw, 4rem);
		object-fit: contain;
	}

	.impact-list li > span:last-child {
		font-family: var(--font-blur);
		font-size: 11px;
		font-weight: 700;
		line-height: 1;
		text-transform: uppercase;
	}

	.goals-section {
		padding: 3.4rem 0 4.2rem;
		color: var(--page-light);
		text-align: center;
		background: var(--page-green);
	}

	.goals-section h2 {
		color: #fff;
		font-size: clamp(2rem, 8vw, 4.5rem);
		line-height: 1;
	}

	.goals-carousel {
		margin-top: 3.2rem;
	}

	.goals-track {
		display: flex;
		gap: 2rem;
		overflow-x: auto;
		margin: 0;
		padding: 0 calc((100% - min(68vw, 20rem)) / 2);
		list-style: none;
		scroll-behavior: smooth;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
		-webkit-overflow-scrolling: touch;
