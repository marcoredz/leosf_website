---
import ParticipationFormLink from "../components/participate/ParticipationFormLink.astro";
import SiteFooter from "../components/common/SiteFooter.astro";
import Layout from "../layouts/Layout.astro";

const opportunities = [
	{
		number: "01",
		title: "Volontari",
		description:
			"Entra nel team e vivi il festival da dentro: organizzazione, accoglienza, allestimenti e tanto altro.",
		background: "bg-leof-orange-light",
		textColor: "text-background-dark",
	},
	{
		number: "02",
		title: "Partner",
		description:
			"Costruiamo insieme collaborazioni capaci di lasciare un segno sul territorio e sulla comunità.",
		background: "bg-leof-purple",
		textColor: "text-background-light",
	},
	{
		number: "03",
		title: "Espositori",
		description:
			"Porta al festival il tuo progetto, i tuoi prodotti o la tua creatività e incontra un pubblico curioso.",
		background: "bg-leof-green",
		textColor: "text-background-light",
	},
];
---

<Layout
	title="Partecipa | Laveno End Of Summer Fest 2026"
	description="Partecipa al Laveno End Of Summer Fest 2026 come volontario, partner o espositore. Compila il modulo di iscrizione."
>
	<main class="w-full min-w-0 overflow-x-clip">
		<section class="flex min-h-[78svh] bg-background-dark px-5 pb-14 pt-32 text-background-light sm:px-8 sm:pb-20 sm:pt-36">
			<div class="mx-auto flex w-full max-w-5xl flex-col justify-between gap-16">
				<div>
					<p class="font-plex text-sm uppercase leading-tight sm:text-base">
						Laveno End Of Summer Fest
					</p>
					<h1 class="mt-5 max-w-5xl font-blur text-[clamp(3.7rem,12vw,9.5rem)] uppercase leading-[0.86]">
						Partecipa
					</h1>
				</div>

				<div class="grid gap-8 border-t border-background-light/30 pt-8 md:grid-cols-[minmax(0,1.15fr)_auto] md:items-end">
					<div>
						<p class="max-w-2xl font-blur text-[clamp(1.9rem,5vw,3.8rem)] uppercase leading-none">
							Il festival prende vita con te.
						</p>
						<p class="mt-5 max-w-xl font-plex text-base leading-tight sm:text-lg">
							Vuoi unirti al team, collaborare con noi o portare il tuo progetto al festival? Raccontaci chi sei compilando il modulo.
						</p>
					</div>

					<ParticipationFormLink />
				</div>
			</div>
		</section>

		<section class="bg-background-light px-5 py-14 text-background-dark sm:px-8 sm:py-20">
			<div class="mx-auto w-full max-w-5xl">
				<header class="grid gap-5 md:grid-cols-[0.9fr_1.1fr] md:items-end md:gap-10">
					<h2 class="font-blur text-[clamp(2.8rem,6vw,4.5rem)] uppercase leading-none">
						Come puoi<br />partecipare
					</h2>
					<p class="max-w-lg font-plex text-sm leading-tight md:justify-self-end sm:text-base">
						Tre modi diversi per entrare a far parte della prossima edizione. Un solo modulo per candidarti.
					</p>
				</header>

				<div class="mt-10 grid items-start gap-3 md:mt-14 md:grid-cols-3">
					{
						opportunities.map(({ number, title, description, background, textColor }) => (
							<article
								class:list={[
									"rounded-3xl p-6 sm:p-7",
									background,
									textColor,
								]}
							>
								<p class="font-plex text-xs uppercase leading-none opacity-75 sm:text-sm">
									{number} / Partecipa
								</p>
								<h3 class="mt-3 font-blur text-[clamp(2.15rem,4.5vw,3rem)] uppercase leading-none md:text-[2.2rem] lg:text-[2.65rem]">
									{title}
								</h3>
								<p class="mt-6 border-t border-current/25 pt-5 font-plex text-sm leading-tight sm:text-base">
									{description}
								</p>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<section class="bg-leof-orange-light px-5 py-16 text-background-dark sm:px-8 sm:py-24">
			<div class="mx-auto grid w-full max-w-5xl gap-10 md:grid-cols-[minmax(0,1fr)_auto] md:items-end">
				<div>
					<p class="font-plex text-xs uppercase leading-tight opacity-75 sm:text-sm">
						Volontari · Partner · Espositori
					</p>
					<h2 class="mt-4 max-w-3xl font-blur text-[clamp(2.8rem,6vw,4.5rem)] uppercase leading-[0.9]">
						Ci sei anche tu?
					</h2>
					<p class="mt-6 max-w-xl font-plex text-sm leading-tight sm:text-base">
						Compila il modulo con i tuoi dati e seleziona il modo in cui vuoi partecipare. Ti ricontatteremo noi.
					</p>
				</div>

				<ParticipationFormLink theme="dark" label="Iscriviti ora" />
			</div>
		</section>

		<SiteFooter />
	</main>
</Layout>
