---
import { Image, getImage } from "astro:assets";
import landingImage from "../../assets/landing-image.jpg";
import SpotifyPlaylistButton from "./SpotifyPlaylistButton.astro";

const placeholder = await getImage({ src: landingImage, width: 20, quality: 10, format: "avif" });
---

<section class="relative flex min-h-svh overflow-hidden bg-background-dark px-5 py-24 text-background-light">
	<div
		class="absolute inset-0 scale-105"
		style={`background-image: url(${placeholder.src}); background-size: cover; background-position: center; filter: blur(8px);`}
		aria-hidden="true"
	>
		<Image
			src={landingImage}
			alt=""
			widths={[640, 1024, 1536, 2048]}
			sizes="100vw"
			format="avif"
			quality={5}
			class="h-full w-full object-cover"
			loading="eager"
		/>
	</div>
	<div class="absolute inset-0 bg-background-dark/35" aria-hidden="true"></div>
	<div class="absolute inset-x-0 bottom-0 z-1 h-[32svh] bg-linear-to-b from-transparent via-background-dark/80 to-background-dark" aria-hidden="true"></div>

	<div class="relative z-10 mx-auto flex min-h-[calc(100svh-12rem)] w-full max-w-5xl flex-col items-center text-center">
		<div class="landing-main flex w-full flex-1 flex-col items-center justify-center pb-12">
			<p class="landing-edition font-plex text-xl uppercase leading-none sm:text-2xl lg:text-[1.65rem]">
				V Edizione
			</p>
			<h1 class="landing-festival-title mt-8 max-w-[20rem] font-blur text-[clamp(1.3rem,3.8vw,3.4rem)] uppercase leading-[0.92] tracking-normal sm:mt-10 sm:max-w-3xl">
				Laveno End Of<br class="sm:hidden" /> Summer Festival
			</h1>
			<h2 class="landing-title mt-6 font-blur text-[clamp(3.25rem,11vw,8.25rem)] uppercase leading-[0.9] tracking-normal lg:mt-8">
				28-29-30<br class="sm:hidden" /> AGOSTO
			</h2>

			<p class="landing-free-entry relative isolate mt-14 px-6 pb-2 pt-4 font-blur text-[clamp(1.4rem,3vw,3.0rem)] uppercase leading-[0.85] text-background-light sm:mt-16 sm:px-8 lg:mt-18">
				<span class="relative z-10">Ingresso gratuito</span>
			</p>
		</div>

		<p class="landing-location mb-14 max-w-3xl font-plex text-sm uppercase leading-tight sm:text-base lg:text-[1.05rem]">
			Laveno Mombello (VA), località Gaggetto
		</p>
	</div>

	<div class="absolute bottom-0 left-1/2 z-10 mb-0 -translate-x-1/2">
		<SpotifyPlaylistButton />
	</div>
</section>

<style>
	.landing-free-entry {
		text-shadow:
			0 0 0.5rem rgb(47 33 34 / 80%),
			0 0 1.5rem rgb(241 190 65 / 65%);
	}

	.landing-free-entry::before {
		position: absolute;
		inset: 10% 3%;
		z-index: -2;
		background:
			radial-gradient(ellipse at 18% 55%, rgb(241 190 65 / 85%) 0%, transparent 48%),
			radial-gradient(ellipse at 78% 42%, rgb(213 61 134 / 75%) 0%, transparent 45%),
			radial-gradient(ellipse at 52% 85%, rgb(64 144 191 / 70%) 0%, transparent 44%);
		content: "";
		filter: blur(1.7rem) saturate(1.3);
		animation: landing-aurora-drift 8s ease-in-out infinite alternate;
		pointer-events: none;
	}

	.landing-free-entry::after {
		position: absolute;
		inset: -45% 12%;
		z-index: -1;
		background: linear-gradient(
			115deg,
			transparent 20%,
			rgb(238 156 61 / 40%) 38%,
			rgb(187 132 176 / 45%) 54%,
			transparent 72%
		);
		content: "";
		filter: blur(1.25rem);
		transform: translateX(-12%) rotate(-8deg);
		animation: landing-aurora-wave 7s ease-in-out infinite alternate;
		pointer-events: none;
	}

	@keyframes landing-aurora-drift {
		0% {
			transform: translate3d(-3%, 4%, 0) scale(0.94) rotate(-2deg);
		}

		100% {
			transform: translate3d(3%, -3%, 0) scale(1.06) rotate(2deg);
		}
	}

	@keyframes landing-aurora-wave {
		0% {
			transform: translateX(-12%) rotate(-8deg) scaleY(0.9);
		}

		100% {
			transform: translateX(12%) rotate(8deg) scaleY(1.1);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.landing-free-entry::before,
		.landing-free-entry::after {
			animation: none;
		}
	}

	@media (min-width: 1024px) {
		.landing-main {
			padding-bottom: 0;
		}

		.landing-edition {
			font-size: 1.35rem;
		}

		.landing-festival-title {
			font-size: clamp(1.5rem, 3.2vw, 2.75rem);
		}

		.landing-title {
			font-size: clamp(3.25rem, 9vw, 7rem);
			margin-top: 2.5rem;
		}

		.landing-location {
			font-size: 0.9rem;
		}

	}

	@media (min-width: 1024px) and (max-height: 760px) {
		.landing-main {
			padding-top: 4.5rem;
		}

		.landing-edition {
			font-size: 1rem;
		}

		.landing-festival-title {
			margin-top: 2rem;
			font-size: 1.6rem;
		}

		.landing-title {
			margin-top: 2rem;
			font-size: clamp(3rem, 7vw, 5rem);
		}

		.landing-location {
			margin-bottom: 2.5rem;
			font-size: 0.8rem;
		}

	}
</style>
