---
type LineupEvent = {
	time: string;
	artist: string;
};

type LineupDay = {
	id: string;
	day: string;
	backgroundClass: string;
	events: LineupEvent[];
};

const lineup: LineupDay[] = [
	{
		id: "venerdi",
		day: "Venerdì 28/08",
		backgroundClass: "bg-leof-orange",
		events: [
			{ time: "17:00 - 17:50", artist: "DJSET" },
			{ time: "18:00 - 18:30", artist: "BIAVA" },
			{ time: "18:40 - 19:10", artist: "DOXX" },
			{ time: "19:20 - 19:50", artist: "GAZA / 29GIULIO" },
			{ time: "20:00 - 20:30", artist: "MATSBY" },
			{ time: "20:40 - 21:20", artist: "TBA" },
			{ time: "21:30 - 22:10", artist: "TBA" },
			{ time: "22:20 - 23:00", artist: "TBA" },
			{ time: "23:00 - 00:00", artist: "JEMEL (DJSEX)" },
			{ time: "00:00 - 01:00", artist: "AUSTRALOPITECHNO" },
		],
	},
	{
		id: "sabato",
		day: "Sabato 29/08",
		backgroundClass: "bg-leof-pink",
		events: [
			{ time: "17:00 - 17:50", artist: "DJSET" },
			{ time: "18:00 - 18:30", artist: "CONTEST > CIRCO" },
			{ time: "18:40 - 19:10", artist: "MANZO / GAZA" },
			{ time: "19:20 - 19:50", artist: "BHADMARI / SAIRO" },
			{ time: "20:00 - 20:30", artist: "BARKEE BAY" },
			{ time: "20:30 - 21:20", artist: "TAIZAL + AFFANNO" },
			{ time: "21:30 - 22:15", artist: "TBA" },
			{ time: "22:20 - 23:00", artist: "TBA" },
			{ time: "23:10 - 00:00", artist: "TBA" },
			{ time: "00:00 - 01:00", artist: "VIBEE DJSET" },
		],
	},
	{
		id: "domenica",
		day: "Domenica 30/08",
		backgroundClass: "bg-leof-green",
		events: [
			{ time: "17:00 - 17:50", artist: "DJ SET" },
			{ time: "18:00 - 18:30", artist: "GEREMIA" },
			{ time: "18:40 - 19:10", artist: "EVA" },
			{ time: "19:20 - 19:50", artist: "BLU" },
			{ time: "20:00 - 20:30", artist: "VOLPI" },
			{ time: "20:40 - 21:20", artist: "LUCA RE" },
			{ time: "21:30 - 22:15", artist: "TBA" },
			{ time: "22:25 - 23:10", artist: "LONGO DJ SET" },
			{ time: "23:15 - 00:30", artist: "DEIV DJ SET" },
		],
	},
];
---

<section class="bg-background-dark px-5 py-14 text-white sm:px-8 sm:py-20">
	<div class="mx-auto w-full max-w-5xl">
		<h2 class="text-center font-blur text-[clamp(3rem,9vw,7rem)] uppercase leading-none">
			Line Up 2026
		</h2>
	</div>
</section>

{
	lineup.map(({ id, day, backgroundClass, events }) => (
		<section
			aria-labelledby={`lineup-${id}`}
			class:list={[
				backgroundClass,
				"px-5 py-12 text-background-dark sm:px-8 sm:py-16",
			]}
		>
			<div class="mx-auto w-full max-w-5xl">
				<h3
					id={`lineup-${id}`}
					class="font-blur text-[clamp(2.5rem,8vw,5.5rem)] uppercase leading-none"
				>
					{day}
				</h3>

				<ol class="mt-6 flex flex-col gap-3 sm:mt-8 sm:gap-4">
					{events.map(({ time, artist }, eventIndex) => {
						const isRedacted = artist === "TBA";
						const redactedVariant = `lineup-redacted-${(eventIndex % 3) + 1}`;

						return (
							<li class="grid min-h-8 grid-cols-[minmax(8.5rem,auto)_1fr] items-baseline gap-4 text-sm uppercase leading-tight sm:grid-cols-[minmax(12rem,auto)_1fr] sm:text-2xl lg:text-3xl">
								<time class="whitespace-nowrap">{time}</time>
								<span
									class:list={[
										"text-right font-plex",
										isRedacted && "lineup-redacted",
										isRedacted && redactedVariant,
									]}
								>
									{isRedacted ? (
										<span class="sr-only">Artista da annunciare</span>
									) : (
										artist
									)}
								</span>
							</li>
						);
					})}
				</ol>
			</div>
		</section>
	))
}
