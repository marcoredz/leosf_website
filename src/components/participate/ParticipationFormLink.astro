---
interface Props {
	label?: string;
	theme?: "light" | "dark";
}

const {
	label = "Compila il modulo",
	theme = "light",
} = Astro.props;

const formUrl = "https://forms.cloud.microsoft/e/uAqNHQwvjn";
---

<a
	href={formUrl}
	target="_blank"
	rel="noreferrer"
	class:list={[
		"group inline-flex min-h-14 items-center justify-between gap-6 rounded-full border px-6 py-3 font-plex text-sm uppercase leading-tight transition-colors sm:min-h-16 sm:px-8 sm:text-base",
		theme === "light"
			? "border-background-light bg-background-light text-background-dark hover:bg-transparent hover:text-background-light"
			: "border-background-dark bg-background-dark text-background-light hover:bg-transparent hover:text-background-dark",
	]}
>
	<span>{label}</span>
	<span
		class="text-xl leading-none transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
		aria-hidden="true"
	>
		↗
	</span>
	<span class="sr-only">Si apre in una nuova scheda</span>
</a>
