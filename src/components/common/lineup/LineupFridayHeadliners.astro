---
import { Image } from "astro:assets";
import marteImage from "../../../assets/artists/marte.jpeg";
import sallyCruzImage from "../../../assets/artists/sallycruz.jpg";
import sparkRed from "../../../assets/ui/spark-red.png";
import ArtistDetailCard from "./ArtistDetailCard.astro";

type Headliner = {
	time: string;
	artist: string;
};

interface Props {
	headliners: Headliner[];
}

const { headliners } = Astro.props;

const getTime = (artistName: string) =>
	headliners.find(({ artist }) => artist === artistName)?.time ?? "";
---

<li class="my-4 grid grid-cols-2 gap-2.5 sm:my-5 sm:gap-4">
	<button
		type="button"
		class="group relative isolate flex aspect-3/5 w-full cursor-pointer flex-col overflow-hidden rounded-2xl border-2 border-background-light bg-background-light text-left text-background-dark"
		aria-label="Apri scheda SALLY CRUZ"
		data-artist-detail-open="sally-cruz-detail"
	>
		<Image
			src={sallyCruzImage}
			alt=""
			widths={[420, 640, 840]}
			sizes="50vw"
			quality={82}
			format="avif"
			class="absolute inset-0 -z-10 size-full object-cover transition-transform duration-500 group-hover:scale-105"
			loading="lazy"
		/>
		<div class="absolute inset-0 -z-10 bg-linear-to-t from-background-dark/78 via-background-dark/20 to-transparent"></div>
		<div class="flex h-full flex-col justify-end p-3 sm:p-5">
			<time class="w-fit rounded bg-leof-red px-2 py-1 font-extrabold font-plex text-[clamp(1rem,3.5vw,1.3rem)] uppercase leading-none text-background-light">
				{getTime("SALLY CRUZ")}
			</time>
			<h4 class="mt-2 font-blur text-[clamp(1.8rem,8vw,4.5rem)] uppercase leading-none text-background-light">
				SALLY CRUZ
			</h4>
		</div>
	</button>

	<button
		type="button"
		class="group relative isolate flex aspect-3/5 w-full cursor-pointer flex-col overflow-hidden rounded-2xl border-2 border-background-light bg-background-light text-left text-background-dark"
		aria-label="Apri scheda MARTE"
		data-artist-detail-open="marte-detail"
	>
		<Image
			src={marteImage}
			alt=""
			widths={[420, 640, 840]}
			sizes="50vw"
			quality={82}
			format="avif"
			class="absolute inset-0 -z-10 size-full object-cover transition-transform duration-500 group-hover:scale-105"
			loading="lazy"
		/>
		<div class="absolute inset-0 -z-10 bg-linear-to-t from-background-dark/78 via-background-dark/20 to-transparent"></div>
		<div class="flex h-full flex-col justify-end p-3 sm:p-5">
			<time class="w-fit rounded bg-leof-red px-2 py-1 font-extrabold font-plex text-[clamp(1rem,3.5vw,1.3rem)] uppercase leading-none text-background-light">
				{getTime("MARTE")}
			</time>
			<h4 class="mt-2 font-blur text-[clamp(2.3rem,10vw,5.4rem)] uppercase leading-none text-background-light">
				MARTE
			</h4>
		</div>
	</button>

	<ArtistDetailCard
		dialogId="sally-cruz-detail"
		artist="SALLY CRUZ"
		date="VENERDÌ 28/08"
		time="21:30"
		image={sallyCruzImage}
		imageAlt="Sally Cruz"
		spark={sparkRed}
		accentClass="text-leof-red"
		bio={`Sally Cruz, aka Alessia Rossi, è una <b>cantautrice</b> fiorentina classe 2003. Appassionata di musica fin dall’infanzia, nel giugno 2022 pubblica il suo primo singolo, con il quale segna il suo debutto nel collettivo <b>Supertango</b>.

		Con forti influenze <b>pop punk</b> e <b>urban</b>, Sally Cruz ha conquistato un posto nella playlist nazionale Hot Hits Italia con il brano “La notte” (feat. Thasup), confermandosi come una delle voci più promettenti della nuova scena italiana.`}
	/>
	<ArtistDetailCard
		dialogId="marte-detail"
		artist="MARTE"
		date="VENERDÌ 28/08"
		time="22:20"
		image={marteImage}
		imageAlt="Marte"
		spark={sparkRed}
		accentClass="text-leof-red"
		bio={`Marte è lo pseudonimo di Martina Totaro (Monte Sant’Angelo - FG, 2004). Grazie a un mix di <b>hip-hop old school</b> e influenze internazionali, si impone rapidamente nella scena per il suo flow diretto e senza filtri.

		Nel 2024 rilascia il progetto <i>STAY ON BARS</i> e nel 2025 il singolo “Fuori Controllo”, tracciando la sua strada come una delle penne più indipendenti e incisive del nuovo rap italiano.`}
	/>
</li>
