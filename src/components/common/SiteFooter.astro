---
import { Icon } from "astro-icon/components";
import { contactDetails, socials } from "../../data/contacts";
---

<footer class="bg-background-dark px-5 py-10 text-center text-background-light sm:px-8">
	<div class="mx-auto flex w-full min-w-0 max-w-5xl flex-col items-center gap-5">
		<address class="w-full min-w-0 max-w-full not-italic">
			{
				contactDetails.map(({ value, href, external }) => (
					<a
						href={href}
						target={external ? "_blank" : undefined}
						rel={external ? "noreferrer" : undefined}
						class="block min-w-0 whitespace-pre-line [overflow-wrap:anywhere] font-plex text-xs leading-relaxed transition-colors hover:text-leof-orange-light"
					>
						{value}
					</a>
				))
			}
		</address>

		<nav aria-label="Social" class="flex items-center justify-center gap-2">
			{
				socials.map(({ label, href, icon }) => (
					<a
						href={href}
						target="_blank"
						rel="noreferrer"
						aria-label={label}
						class="grid h-7 w-7 place-items-center rounded-full border border-background-light/70 text-background-light transition-colors hover:bg-background-light hover:text-background-dark"
					>
						<Icon name={icon} class="h-3.5 w-3.5" aria-hidden="true" />
					</a>
				))
			}
		</nav>
	</div>
</footer>
