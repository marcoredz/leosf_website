---
import { Image } from "astro:assets";
import eraseTextLong from "../../assets/ui/erase-text-long.png";
import eraseTextShort from "../../assets/ui/erase-text-short.png";
import eraseTextGreenLong from "../../assets/ui/erase-text-green-long.png";
import eraseTextGreenShort from "../../assets/ui/erase-text-green-short.png";
import eraseTextOrangeLong from "../../assets/ui/erase-text-orange-long.png";
import eraseTextOrangeShort from "../../assets/ui/erase-text-orange-short.png";
import eraseTextVioletLong from "../../assets/ui/erase-text-violet-long.png";
import eraseTextVioletShort from "../../assets/ui/erase-text-violet-short.png";
import eyeDivider from "../../assets/ui/eye-divider.png";
import moonDivider from "../../assets/ui/moon-divider.png";
import sparkGreen from "../../assets/ui/spark-green.png";
import sparkRed from "../../assets/ui/spark-red.png";
import sparkViolet from "../../assets/ui/spark-violet.png";
import LineupFridayHeadliners from "./lineup/LineupFridayHeadliners.astro";
import LineupSaturdayHeadliners from "./lineup/LineupSaturdayHeadliners.astro";
import LineupSundayHeadliners from "./lineup/LineupSundayHeadliners.astro";

type RedactionLength = "short" | "long";
type RedactionColor = "neutral" | "orange" | "green" | "violet";

type LineupEvent = {
	time: string;
	artist: string;
	longness?: RedactionLength;
	color?: Exclude<RedactionColor, "neutral">;
	isHeadliner?: boolean;
};

type LineupDay = {
	id: string;
	day: string;
	spark: ImageMetadata;
	events: LineupEvent[];
};

interface Props {
	blendWithPreviousSection?: boolean;
}

const { blendWithPreviousSection = false } = Astro.props;

const redactedImages: Record<RedactionColor, Record<RedactionLength, ImageMetadata>> = {
	neutral: {
		short: eraseTextShort,
		long: eraseTextLong,
	},
	orange: {
		short: eraseTextOrangeShort,
		long: eraseTextOrangeLong,
	},
	green: {
		short: eraseTextGreenShort,
		long: eraseTextGreenLong,
	},
	violet: {
		short: eraseTextVioletShort,
		long: eraseTextVioletLong,
	},
};

const getRedactedImage = (
	length: RedactionLength = "long",
	color: RedactionColor = "neutral",
) => redactedImages[color][length];

const lineup: LineupDay[] = [
	{
		id: "venerdi",
		day: "Venerdì 28/08",
		spark: sparkRed,
		events: [
			{ time: "17:00 - 17:50", artist: "DJ SET" },
			{ time: "18:00 - 18:30", artist: "ROEDEER" },
			{ time: "18:40 - 19:10", artist: "DOXX" },
			{ time: "19:20 - 19:50", artist: "29GIULIO" },
			{ time: "20:00 - 20:30", artist: "VEROSIMILE" },
			{ time: "20:40 - 21:20", artist: "PRINCIPE" },
			{ time: "21:30 - 22:10", artist: "SALLY CRUZ", isHeadliner: true }, // Headliner 1
			{ time: "22:20 - 23:00", artist: "MARTE", isHeadliner: true }, // Headliner 2
			{ time: "23:00 - 00:00", artist: "DON'T TELL MAMA" },
			{ time: "00:00 - 01:00", artist: "AUSTRALOPITECHNO" },
		],
	},
	{
		id: "sabato",
		day: "Sabato 29/08",
		spark: sparkViolet,
		events: [
			{ time: "17:00 - 17:50", artist: "DJ SET" },
			{ time: "18:00 - 18:30", artist: "CONTEST" },
			{ time: "18:40 - 19:10", artist: "MANZO" },
			{ time: "19:20 - 19:50", artist: "ZAGA" },
			{ time: "20:00 - 20:30", artist: "MATSBY" },
			{ time: "20:30 - 21:20", artist: "TAIZAL + AFFANNO" },
			{ time: "21:30 - 22:15", artist: "VAZ TE", isHeadliner: true }, // Headliner 1
			{ time: "22:20 - 23:00", artist: "DISME", isHeadliner: true }, // Headliner 2
			{ time: "23:10 - 00:00", artist: "CHRYVERDE DJ SET" },
			// { time: "00:00 - 01:00", artist: "VIBEE DJSET" },
		],
	},
	{
		id: "domenica",
		day: "Domenica 30/08",
		spark: sparkGreen,
		events: [
			{ time: "17:00 - 17:50", artist: "DJ SET" },
			{ time: "18:00 - 18:30", artist: "CONTEST" },
			{ time: "18:40 - 19:10", artist: "EVA" },
			{ time: "19:20 - 19:50", artist: "BLU" },
			{ time: "20:00 - 20:30", artist: "LIL JOLIE", isHeadliner: true }, // Headliner 1
			{ time: "20:30 - 21:20", artist: "VOLPI" },
			{ time: "21:30 - 22:15", artist: "LUCA RE" },
			{ time: "22:20 - 23:00", artist: "SISSI", isHeadliner: true }, // Headliner 2
			{ time: "23:10 - 00:00", artist: "LONGO DJ SET" },
			{ time: "00:00 - 01:00", artist: "DEIV DJ SET" },
		],
	},
];
---

<section class="relative bg-background-dark px-6 pb-16 pt-14 text-background-light sm:px-8 sm:pb-24 sm:pt-20">
	{blendWithPreviousSection && (
		<div class="pointer-events-none absolute inset-x-0 top-0 h-24 -translate-y-full bg-linear-to-b from-transparent to-background-dark" aria-hidden="true"></div>
	)}

	<div class="mx-auto w-full max-w-4xl">
		<Image
			src={eyeDivider}
			alt=""
			width={640}
			height={38}
			format="avif"
			quality={80}
			class="mx-auto mb-10 h-auto w-full max-w-3xl object-contain sm:mb-14"
			loading="lazy"
		/>

		<h2 class="text-center text-background-light font-blur text-[clamp(2.7rem,8vw,6.25rem)] uppercase leading-none">
			Line Up 2026
		</h2>

		<div class="mt-14 flex flex-col gap-16 sm:mt-18 sm:gap-20">
			{lineup.map(({ id, day, spark, events }) => (
				<section aria-labelledby={`lineup-${id}`}>
					<div class="grid grid-cols-[2.75rem_1fr_2.75rem] items-center gap-3 sm:grid-cols-[4.5rem_1fr_4.5rem] sm:gap-6">
						<Image
							src={spark}
							alt=""
							widths={[72]}
							quality={80}
							format="avif"
							class="mx-auto size-9 object-contain sm:size-13"
							loading="lazy"
						/>
						<h3
							id={`lineup-${id}`}
							class="text-center text-background-light font-blur text-[clamp(2rem,6vw,4.5rem)] uppercase leading-none"
						>
							{day}
						</h3>
						<Image
							src={spark}
							alt=""
							widths={[72]}
							quality={80}
							format="avif"
							class="mx-auto size-9 object-contain sm:size-13"
							loading="lazy"
						/>
					</div>

					{(() => {
						const firstHeadlinerIndex = events.findIndex(({ isHeadliner }) => isHeadliner);
						const headlinerEvents = events.filter(({ isHeadliner }) => isHeadliner);
						const eventsBeforeHeadliners = events
							.slice(0, firstHeadlinerIndex)
							.filter(({ isHeadliner }) => !isHeadliner);
						const eventsAfterHeadliners = events
							.slice(firstHeadlinerIndex)
							.filter(({ isHeadliner }) => !isHeadliner);
						const hasHeadlinerSection = ["venerdi", "sabato", "domenica"].includes(id) && firstHeadlinerIndex >= 0 && headlinerEvents.length > 0;

						const renderEvent = ({ time, artist, longness, color }: LineupEvent) => {
							const isRedacted = artist === "TBA";
							const isShortRedaction = longness === "short";
							const redactedImage = getRedactedImage(longness, color);
							const redactedWidthClass = isShortRedaction
								? "w-[clamp(5.5rem,18vw,10rem)]"
								: "w-[clamp(7rem,24vw,14rem)]";

							return (
								<li class="grid min-h-6 grid-cols-[minmax(7.4rem,auto)_1fr] items-baseline gap-3 font-plex text-[clamp(1rem,4.1vw,2rem)] uppercase leading-tight sm:grid-cols-[minmax(12rem,auto)_1fr] sm:gap-6">
									<time class="whitespace-nowrap">{time}</time>
									<span class="min-w-0 text-right">
										{isRedacted ? (
											<>
												<span class="sr-only">Artista da annunciare</span>
												<Image
													src={redactedImage}
													alt=""
													widths={[200, 300]}
													quality={20}
													format="avif"
													class:list={[
														"ml-auto inline-block h-auto align-middle",
														redactedWidthClass,
													]}
													loading="lazy"
												/>
											</>
										) : (
											artist
										)}
									</span>
								</li>
							);
						};

						return (
							<ol class="mt-7 flex flex-col gap-2.5 sm:mt-9 sm:gap-3">
								{id === "domenica"
									? events.map((event) =>
											event.isHeadliner
												? <LineupSundayHeadliners headliners={[event]} />
												: renderEvent(event),
										)
									: hasHeadlinerSection
									? (
										<>
											{eventsBeforeHeadliners.map(renderEvent)}
											{id === "venerdi" && <LineupFridayHeadliners headliners={headlinerEvents} />}
											{id === "sabato" && <LineupSaturdayHeadliners headliners={headlinerEvents} />}
											{eventsAfterHeadliners.map(renderEvent)}
										</>
									)
									: events.map(renderEvent)}
							</ol>
						);
					})()}
				</section>
			))}
		</div>

		<Image
			src={moonDivider}
			alt=""
			width={640}
			height={46}
			format="avif"
			quality={80}
			class="mx-auto mt-16 h-auto w-full max-w-3xl object-contain opacity-80 sm:mt-20"
			loading="lazy"
		/>
	</div>
</section>
