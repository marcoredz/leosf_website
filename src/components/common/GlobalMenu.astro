---
import { Image } from "astro:assets";
import eofLogo from "../../assets/common/eof-logo-og.png";

const menuItems = [
	{ label: "Home", href: "/" },
	{ label: "Programma", href: "/programma" },
	{ label: "Il Festival", href: "/il-festival" },
	{ label: "Sostenibilità", href: "/sostenibilita" },
	{ label: "Gallery", href: "/gallery" },
	{ label: "Partecipa", href: "/partecipa" },
	{ label: "Contatti", href: "/contatti" },
];

const desktopMenuItems = menuItems.filter(({ label }) => label !== "Home");
---

<header class="site-header" data-site-header>
	<a href="/" aria-label="Laveno End Of Summer Fest" class="site-header-logo">
		<Image
			src={eofLogo}
			alt="Laveno End Of Summer Fest"
			format="webp"
			width={180}
			quality={50}
			loading="eager"
		/>
	</a>

	<!-- Navigation for desktop, hidden on mobile -->
	<nav class="site-header-nav" aria-label="Navigazione principale">
		<ul>
			{
				desktopMenuItems.map(({ label, href }) => (
					<li>
						<a href={href}>{label}</a>
					</li>
				))
			}
		</ul>
	</nav>

	<button
		type="button"
		class="menu-toggle"
		aria-label="Apri menu"
		aria-controls="site-menu"
		aria-expanded="false"
		data-menu-open
	>
		<span aria-hidden="true"></span>
		<span aria-hidden="true"></span>
		<span aria-hidden="true"></span>
	</button>
</header>

<!-- Mobile menu, hidden on desktop -->
<nav
	id="site-menu"
	class="site-menu"
	aria-label="Menu principale"
	aria-hidden="true"
	data-site-menu
>
	<button
		type="button"
		class="menu-close"
		aria-label="Chiudi menu"
		data-menu-close
	>
		<span aria-hidden="true"></span>
		<span aria-hidden="true"></span>
	</button>

	<ul class="site-menu-list">
		{
			menuItems.map(({ label, href }) => (
				<li>
					<a href={href} data-menu-link>
						{label}
					</a>
				</li>
			))
		}
	</ul>
</nav>

<script>
	const header = document.querySelector<HTMLElement>("[data-site-header]");
	const menu = document.querySelector<HTMLElement>("[data-site-menu]");
	const openButton = document.querySelector<HTMLButtonElement>("[data-menu-open]");
	const closeButton = document.querySelector<HTMLButtonElement>("[data-menu-close]");
	const menuLinks = document.querySelectorAll<HTMLAnchorElement>("[data-menu-link]");
	const desktopMenuQuery = window.matchMedia("(min-width: 1024px)");
	let lastScrollY = window.scrollY;
	let isScrollTicking = false;

	function updateHeaderVisibility() {
		const currentScrollY = window.scrollY;
		const scrollDelta = currentScrollY - lastScrollY;
		const isMenuOpen = menu?.classList.contains("is-open") ?? false;
		const shouldHide = currentScrollY > 80 && scrollDelta > 8 && !isMenuOpen;
		const shouldShow = scrollDelta < -8 || currentScrollY <= 80 || isMenuOpen;

		if (shouldHide) {
			header?.classList.add("is-hidden");
		}

		if (shouldShow) {
			header?.classList.remove("is-hidden");
		}

		lastScrollY = currentScrollY;
		isScrollTicking = false;
	}

	function requestHeaderVisibilityUpdate() {
		if (isScrollTicking) {
			return;
		}

		isScrollTicking = true;
		window.requestAnimationFrame(updateHeaderVisibility);
	}

	function setMenuState(isOpen: boolean, restoreFocus = true) {
		menu?.classList.toggle("is-open", isOpen);
		openButton?.classList.toggle("is-active", isOpen);
		openButton?.setAttribute("aria-expanded", String(isOpen));
		menu?.setAttribute("aria-hidden", String(!isOpen));
		document.body.classList.toggle("menu-overlay-open", isOpen);
		header?.classList.remove("is-hidden");

		if (isOpen) {
			closeButton?.focus();
		} else if (restoreFocus) {
			openButton?.focus();
		}
	}

	openButton?.addEventListener("click", () => setMenuState(true));
	closeButton?.addEventListener("click", () => setMenuState(false));

	menuLinks.forEach((link) => {
		link.addEventListener("click", () => setMenuState(false));
	});

	desktopMenuQuery.addEventListener("change", (event) => {
		if (event.matches) {
			setMenuState(false, false);
		}
	});

	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape") {
			setMenuState(false);
		}
	});

	window.addEventListener("scroll", requestHeaderVisibilityUpdate, {
		passive: true,
	});
</script>

<style>
	.site-header {
		--site-header-blur-tail: clamp(2.25rem, 7vw, 5rem);

		position: fixed;
		top: 0;
		left: 0;
		z-index: 60;
		display: flex;
		width: 100%;
		height: 5.25rem;
		align-items: center;
		justify-content: space-between;
		padding: max(0.75rem, env(safe-area-inset-top)) max(1rem, env(safe-area-inset-right)) 0.75rem max(1rem, env(safe-area-inset-left));
		color: var(--color-background-light);
		transition: transform 220ms ease;
	}

	.site-header::before {
		content: "";
		position: absolute;
		left: 0;
		right: 0;
		top: 0;
		height: calc(100% + var(--site-header-blur-tail));
		pointer-events: none;
		backdrop-filter: blur(18px) saturate(130%);
		-webkit-backdrop-filter: blur(18px) saturate(130%);
		mask-image: linear-gradient(to bottom, black 0%, black 54%, transparent 100%);
		-webkit-mask-image: linear-gradient(to bottom, black 0%, black 54%, transparent 100%);
	}

	.site-header > * {
		position: relative;
		z-index: 1;
	}

	.site-header.is-hidden {
		transform: translateY(calc(-100% - var(--site-header-blur-tail)));
	}

	.site-header-logo {
		display: inline-flex;
		align-items: center;
		width: 4rem;
		line-height: 0;
	}

	.site-header-logo img {
		display: block;
		width: 100%;
		height: auto;
	}

	.site-header-nav {
		display: none;
	}

	.site-header-nav ul {
		display: flex;
		align-items: center;
		gap: clamp(1.25rem, 2vw, 2.25rem);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.site-header-nav a {
		display: inline-flex;
		align-items: center;
		font-family: var(--font-plex);
		font-size: 0.8rem;
		line-height: 1;
		text-transform: uppercase;
		text-decoration: none;
		color: currentColor;
		transition: color 180ms ease;
	}

	.site-header-nav a:hover {
		color: var(--color-leof-red);
	}

	.menu-toggle,
	.menu-close {
		display: grid;
		width: 3.25rem;
		height: 3.25rem;
		place-items: center;
		border: 0;
		color: var(--color-background-light);
		background: transparent;
		transition:
			color 180ms ease,
			background-color 180ms ease,
			transform 180ms ease;
	}

	.menu-toggle {
		position: relative;
	}

	.menu-close {
		position: fixed;
		z-index: 80;
		top: max(1rem, env(safe-area-inset-top));
		right: max(1rem, env(safe-area-inset-right));
		color: var(--color-background-dark);
		background: transparent;
	}

	.menu-toggle:hover,
	.menu-close:hover {
		transform: scale(1.04);
	}

	.menu-toggle.is-active {
		pointer-events: none;
		opacity: 0;
	}

	.menu-toggle span,
	.menu-close span {
		position: absolute;
		width: 1.45rem;
		height: 0.125rem;
		border-radius: 999px;
		background: currentColor;
	}

	.menu-toggle span:nth-child(1) {
		transform: translateY(-0.42rem);
	}

	.menu-toggle span:nth-child(3) {
		transform: translateY(0.42rem);
	}

	.menu-close span:nth-child(1) {
		transform: rotate(45deg);
	}

	.menu-close span:nth-child(2) {
		transform: rotate(-45deg);
	}

	.site-menu {
		position: fixed;
		inset: 0;
		z-index: 70;
		display: flex;
		align-items: flex-end;
		justify-content: center;
		min-height: 100dvh;
		padding: 5.5rem 1.5rem 3rem;
		color: var(--color-background-dark);
		background: var(--color-background-light);
		clip-path: circle(0% at calc(100% - 2.625rem) 2.625rem);
		pointer-events: none;
		visibility: hidden;
		transition:
			clip-path 620ms cubic-bezier(0.76, 0, 0.24, 1),
			visibility 0ms linear 620ms;
	}

	.site-menu.is-open {
		clip-path: circle(150% at calc(100% - 2.625rem) 2.625rem);
		pointer-events: auto;
		visibility: visible;
		transition:
			clip-path 720ms cubic-bezier(0.76, 0, 0.24, 1),
			visibility 0ms linear 0ms;
	}

	.site-menu-list {
		display: flex;
		width: min(100%, 58rem);
		flex-direction: column;
		align-items: flex-end;
		gap: clamp(3.0rem, 3vw, 2.8rem);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.site-menu-list a {
		display: block;
		width: 100%;
		max-width: 100%;
		font-family: var(--font-plex);
		font-size: clamp(2rem, 5.5vw, 4.75rem);
		line-height: 0.9;
		text-align: right;
		text-decoration: none;
		color: currentColor;
		transform: translateY(1rem);
		opacity: 0;
		transition:
			color 180ms ease,
			opacity 360ms ease,
			transform 480ms cubic-bezier(0.22, 1, 0.36, 1);
		transition-delay: 0ms;
	}

	.site-menu.is-open .site-menu-list a {
		transform: translateY(0);
		opacity: 1;
	}

	.site-menu.is-open .site-menu-list li:nth-child(1) a {
		transition-delay: 180ms;
	}

	.site-menu.is-open .site-menu-list li:nth-child(2) a {
		transition-delay: 230ms;
	}

	.site-menu.is-open .site-menu-list li:nth-child(3) a {
		transition-delay: 280ms;
	}

	.site-menu.is-open .site-menu-list li:nth-child(4) a {
		transition-delay: 330ms;
	}

	.site-menu.is-open .site-menu-list li:nth-child(5) a {
		transition-delay: 380ms;
	}

	.site-menu.is-open .site-menu-list li:nth-child(6) a {
		transition-delay: 430ms;
	}

	.site-menu.is-open .site-menu-list li:nth-child(7) a {
		transition-delay: 480ms;
	}

	.site-menu-list a:hover {
		color: var(--color-leof-burgundy);
	}

	:global(body.menu-overlay-open) {
		overflow: hidden;
	}

	@media (max-width: 1023px) {
		.site-menu {
			color: var(--color-background-light);
			background-color: var(--color-background-dark);
			background:
				radial-gradient(circle at 8% 12%, var(--color-leof-orange) 0 3.15rem, transparent 3.2rem),
				radial-gradient(circle at 94% 78%, var(--color-leof-accentPink) 0 4.25rem, transparent 4.3rem),
				linear-gradient(
					154deg,
					transparent 0 47%,
					color-mix(in srgb, var(--color-leof-purple) 42%, transparent) 47% 52%,
					transparent 52%
				),
				var(--color-background-dark);
		}

		.menu-close {
			color: var(--color-background-dark);
			background: var(--color-leof-yellow);
			border: 1px solid var(--color-background-dark);
			border-radius: 0.65rem 1.1rem 0.55rem 1rem;
			box-shadow: 0.25rem 0.3rem 0 var(--color-leof-purple);
			transform: rotate(2deg);
		}

		.menu-close:hover,
		.menu-close:focus-visible {
			color: var(--color-background-dark);
			background: var(--color-leof-orange-light);
			transform: rotate(-3deg) scale(1.05);
		}

		.menu-close:focus-visible {
			outline: 0.18rem solid var(--color-background-light);
			outline-offset: 0.22rem;
		}

		.site-menu-list {
			align-items: stretch;
			gap: clamp(0.75rem, 1.8vh, 1.15rem);
		}

		.site-menu-list li {
			--menu-card-background: var(--color-leof-orange);
			--menu-card-color: var(--color-background-dark);
			--menu-card-color: color-mix(in srgb, var(--color-background-dark) 55%, black);

			width: fit-content;
			max-width: 100%;
			align-self: flex-end;
			transform: rotate(-1.25deg);
		}

		.site-menu-list li:nth-child(even) {
			align-self: flex-start;
			transform: rotate(1.25deg);
		}

		.site-menu-list li:nth-child(4) {
			--menu-card-background: var(--color-leof-green);
		}

		.site-menu-list a {
			width: auto;
			padding: 0.55rem clamp(0.9rem, 4vw, 1.5rem);
			border: 1px solid var(--color-background-dark);
			border-radius: 0.65rem 1.25rem 0.7rem 1.4rem;
			font-weight: 600;
			color: var(--menu-card-color);
			background: var(--menu-card-background);
			box-shadow: 0.3rem 0.32rem 0 color-mix(in srgb, var(--color-background-light) 28%, transparent);
			transform: translateY(1rem) scale(0.96);
		}

		.site-menu-list li:nth-child(even) a {
			border-radius: 1.3rem 0.65rem 1.2rem 0.7rem;
		}

		.site-menu.is-open .site-menu-list a {
			transform: translateY(0) scale(1);
		}

		.site-menu-list a:hover,
		.site-menu-list a:focus-visible {
			color: var(--menu-card-color);
			filter: saturate(1.16) brightness(1.06);
			transform: translateY(-0.12rem) scale(1.025);
		}

		.site-menu-list a:focus-visible {
			outline: 0.18rem solid var(--color-background-light);
			outline-offset: 0.22rem;
		}
	}

	@media (min-width: 1024px) {
		.site-header {
			height: 5rem;
			padding-right: max(2rem, env(safe-area-inset-right));
			padding-left: max(2rem, env(safe-area-inset-left));
		}

		.site-header-logo {
			width: 3.75rem;
		}

		.site-header-nav {
			display: block;
			margin-left: auto;
		}

		.site-header-nav ul {
			gap: 0.18rem;
			isolation: isolate;
		}

		.site-header-nav li {
			--menu-strip-background: var(--color-background-light);
			--menu-strip-color: var(--color-background-dark);
			--menu-strip-color: color-mix(in srgb, var(--color-background-dark) 55%, black);

			transform: translateY(-0.12rem) rotate(-1.25deg);
		}

		.site-header-nav li:nth-child(even) {
			transform: translateY(0.12rem) rotate(1.25deg);
		}

		.site-header-nav li:nth-child(3) {
			--menu-strip-background: var(--color-leof-green);
		}

		.site-header-nav a {
			min-height: 2.35rem;
			padding: 0.7rem clamp(0.65rem, 1.15vw, 1rem);
			border: 1px solid var(--color-background-dark);
			border: 1px solid color-mix(in srgb, var(--color-background-dark) 32%, transparent);
			border-radius: 0.55rem 1rem 0.65rem 1.15rem;
			font-weight: 600;
			color: var(--menu-strip-color);
			background: var(--menu-strip-background);
			box-shadow: 0 0.25rem 0 var(--color-background-dark);
			white-space: nowrap;
			transition:
				color 180ms ease,
				filter 180ms ease,
				transform 180ms ease,
				box-shadow 180ms ease;
		}

		.site-header-nav li:nth-child(even) a {
			border-radius: 1.1rem 0.6rem 1rem 0.55rem;
		}

		.site-header-nav a:hover,
		.site-header-nav a:focus-visible {
			color: var(--menu-strip-color);
			filter: saturate(1.18) brightness(1.06);
			transform: translateY(-0.16rem);
			box-shadow: 0 0.4rem 0 var(--color-background-dark);
		}

		.site-header-nav a:focus-visible {
			outline: 0.18rem solid var(--color-background-light);
			outline-offset: 0.18rem;
		}

		.menu-toggle,
		.menu-close,
		.site-menu {
			display: none;
		}

		:global(body.menu-overlay-open) {
			overflow: auto;
		}
	}

	@media (max-width: 640px) {
		.site-header {
			height: 4.875rem;
			padding: max(0.5rem, env(safe-area-inset-top)) max(0.5rem, env(safe-area-inset-right)) 0.5rem max(0.75rem, env(safe-area-inset-left));
		}

		.site-header-logo {
			width: 3.75rem;
		}

		.menu-toggle,
		.menu-close {
			width: 3.875rem;
			height: 3.875rem;
		}

		.site-menu {
			flex-direction: column;
			align-items: stretch;
			justify-content: flex-start;
			overflow-y: auto;
			padding:
				max(6rem, calc(env(safe-area-inset-top) + 5rem))
				max(1.25rem, env(safe-area-inset-right))
				max(2rem, env(safe-area-inset-bottom))
				max(1.25rem, env(safe-area-inset-left));
			clip-path: circle(0% at calc(100% - 2.4375rem) 2.4375rem);
		}

		.site-menu.is-open {
			clip-path: circle(160% at calc(100% - 2.4375rem) 2.4375rem);
		}

		.site-menu-list {
			flex-shrink: 0;
			gap: clamp(1rem, 2.75vh, 1.4rem);
			margin-top: auto;
		}

		.site-menu-list a {
			font-size: clamp(1.5rem, 7vw, 2.15rem);
			line-height: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header,
		.site-header-nav a,
		.menu-toggle,
		.menu-close,
		.site-menu,
		.site-menu-list a {
			transition: none;
		}

		.site-menu,
		.site-menu.is-open {
			clip-path: none;
		}
	}
</style>
