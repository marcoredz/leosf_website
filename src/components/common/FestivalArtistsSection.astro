---
import { Image } from "astro:assets";
import moonDivider from "../../assets/ui/moon-divider.png";
import SiteButton from "./SiteButton.astro";

interface Props {
	id?: string;
	title?: string;
	blendWithPreviousSection?: boolean;
}

const {
	id = "artisti",
	title = "Lineup 2026",
	blendWithPreviousSection = false,
} = Astro.props;

const artistRows = [
	{
		level: "headliner",
		artists: ["Vaz Tè", "Disme", "Sissi", "Marte"],
	},
	{
		level: "featured",
		artists: ["Lil Jolie", "Sally Cruz", "Principe", "Volpi", "Chryverde"],
	},
	{
		level: "featured",
		artists: ["Luca Re", "Taizal e Affanno", "Maisby", "Deiv"],
	},
	{
		level: "standard",
		artists: [
			"Longo",
			"Zaga",
			"Doxx",
			"Verosimile",
			"29Giulio",
			"Blu",
			"Don't Tell Mama",
		],
	},
	{
		level: "standard",
		artists: [
			"Èva",
			"Manzo",
			"Roedeer",
			"Lavíe",
			"Australopitechno",
			"Jaen",
			"Malaffari",
		],
	},
] as const;
---

<section
	id={id}
	class="artist-poster relative cursor-pointer bg-background-dark px-5 py-16 text-background-light sm:px-8 sm:py-24"
	data-lineup-section
	data-lineup-href="/lineup"
	role="link"
	tabindex="0"
	aria-label="Scopri gli orari della lineup completa"
	aria-labelledby={`${id}-title`}
>
	{
		blendWithPreviousSection && (
			<div
				class="pointer-events-none absolute inset-x-0 top-0 h-30 -translate-y-full bg-linear-to-b from-transparent via-background-dark/70 to-background-dark"
				aria-hidden="true"
			></div>
		)
	}

	<div class="relative mx-auto w-full max-w-6xl text-center">
		<h2
			id={`${id}-title`}
			class="font-blur text-[clamp(3.2rem,10vw,8.5rem)] uppercase leading-[0.82] text-leof-orange-light"
		>
			{title}
		</h2>

		<div class="mt-8 flex flex-col gap-3 sm:mt-10 sm:gap-4">
			{
				artistRows.map(({ level, artists }, rowIndex) => {
					const artistOffset = artistRows
						.slice(0, rowIndex)
						.reduce((total, row) => total + row.artists.length, 0);

					return (
						<ul
							class:list={["artist-row", `artist-row-${level}`]}
							aria-label={level === "headliner" ? "Headliner" : undefined}
						>
							{artists.map((artist, index) => (
								<>
									<li class="artist-name">
										<span style={`--artist-index: ${artistOffset + index}`}>{artist}</span>
									</li>
									{index < artists.length - 1 && (
										<li
											class="artist-separator"
											style={`--artist-index: ${artistOffset + index + 0.5}`}
											aria-hidden="true"
										></li>
									)}
								</>
							))}
						</ul>
					);
				})
			}
		</div>

		<div class="mt-10 flex justify-center sm:mt-12">
			<SiteButton
				href="/lineup"
				class="w-full max-w-sm px-8 py-5 text-[clamp(1.25rem,5vw,2rem)] sm:max-w-md"
				backgroundColor="var(--color-leof-orange-light)"
				textColor="var(--color-background-dark)"
				hoverBackgroundColor="var(--color-leof-orange-light)"
				hoverTextColor="var(--color-background-dark)"
			>
				Scopri gli orari
			</SiteButton>
		</div>

		<div class="mt-12 flex min-w-0 items-center justify-center gap-5 sm:mt-16 sm:gap-8" aria-hidden="true">
			<Image
				src={moonDivider}
				alt=""
				width={640}
				height={46}
				format="avif"
				quality={80}
				class="h-auto min-w-0 max-w-2xl flex-1 object-contain opacity-75"
				loading="lazy"
			/>
		</div>

	</div>
</section>

<script>
	const artistSections = document.querySelectorAll<HTMLElement>(".artist-poster");

	document.querySelectorAll<HTMLElement>("[data-lineup-section]").forEach((section) => {
		const href = section.dataset.lineupHref;

		if (!href) return;

		section.addEventListener("click", (event) => {
			if (event.target instanceof Element && event.target.closest("a, button")) return;

			window.location.href = href;
		});

		section.addEventListener("keydown", (event) => {
			if (event.target !== section || (event.key !== "Enter" && event.key !== " ")) return;

			event.preventDefault();
			window.location.href = href;
		});
	});

	if ("IntersectionObserver" in window) {
		const artistObserver = new IntersectionObserver(
			(entries, observer) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.closest<HTMLElement>(".artist-poster")?.classList.add("is-visible");
						observer.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.25 },
		);

		artistSections.forEach((section) => {
			const firstArtistRow = section.querySelector<HTMLElement>(".artist-row");

			if (firstArtistRow) {
				artistObserver.observe(firstArtistRow);
			} else {
				section.classList.add("is-visible");
			}
		});
	} else {
		artistSections.forEach((section) => section.classList.add("is-visible"));
	}
</script>

<style>
	.artist-poster {
		isolation: isolate;
	}

	.artist-poster:focus-visible {
		outline: 3px solid var(--color-leof-orange-light);
		outline-offset: -3px;
	}

	.poster-glow {
		position: absolute;
		z-index: -1;
		width: 22rem;
		height: 22rem;
		border-radius: 9999px;
		filter: blur(100px);
		opacity: 0.2;
	}

	.poster-glow-left {
		top: 8%;
		left: -12rem;
		background: var(--color-leof-orange);
	}

	.poster-glow-right {
		right: -12rem;
		bottom: 8%;
		background: var(--color-leof-pink);
	}

	.artist-row {
		--artist-size: 1rem;

		display: flex;
		width: 100%;
		box-sizing: border-box;
		align-items: baseline;
		justify-content: space-between;
		gap: 0;
		margin: 0;
		padding-inline: clamp(0.75rem, 3vw, 2rem);
		list-style: none;
		font-size: var(--artist-size);
	}

	.artist-name {
		flex: 0 1 auto;
		min-width: 0;
		white-space: nowrap;
	}

	.artist-name span {
		display: inline-block;
		opacity: 0;
		transform: translateY(0.35em);
		animation: artist-name-reveal 520ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
		animation-delay: calc(var(--artist-index) * 90ms);
		animation-play-state: paused;
	}

	.artist-poster.is-visible .artist-name span {
		animation-play-state: running;
	}

	.artist-separator {
		opacity: 0;
		transform: scale(0.35);
		animation: artist-separator-reveal 380ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
		animation-delay: calc(var(--artist-index) * 90ms);
		animation-play-state: paused;
	}

	.artist-poster.is-visible .artist-separator {
		animation-play-state: running;
	}

	@keyframes artist-name-reveal {
		from {
			opacity: 0;
			transform: translateY(0.35em);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes artist-separator-reveal {
		from {
			opacity: 0;
			transform: scale(0.35);
		}

		to {
			opacity: 1;
			transform: scale(1);
		}
	}

	.artist-separator {
		flex: 0 0 auto;
		align-self: center;
		width: 0.24em;
		height: 0.24em;
		border-radius: 9999px;
		background: var(--color-leof-pink);
	}

	.artist-row-headliner {
		--artist-size: clamp(1.2rem, 5vw, 4.65rem);

		font-family: var(--font-blur);
		line-height: 0.95;
		text-transform: uppercase;
	}

	.artist-row-headliner .artist-separator {
		background: var(--color-leof-orange-light);
	}

	.artist-row-featured {
		--artist-size: clamp(0.75rem, 3.1vw, 2.45rem);

		font-family: var(--font-blur);
		line-height: 1;
		text-transform: uppercase;
	}

	.artist-row-standard {
		--artist-size: clamp(0.5rem, 2.1vw, 1.7rem);

		font-family: var(--font-blur);
		line-height: 1.15;
		text-transform: uppercase;
	}

	@media (max-width: 40rem) {
		.artist-row {
			display: flex;
			flex-wrap: wrap;
			align-items: baseline;
			justify-content: space-between;
			padding-inline: 0.75rem;
			row-gap: 0.2em;
			white-space: normal;
		}

		.artist-name {
			display: flex;
		}

		.artist-separator {
			display: block;
			margin-inline: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.artist-name span {
			animation: none;
			opacity: 1;
			transform: none;
		}

		.artist-separator {
			animation: none;
			opacity: 1;
			transform: none;
		}
	}
</style>
