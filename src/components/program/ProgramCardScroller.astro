---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

type CardItem = {
	title: string;
	subtitle?: string;
	backgroundClass?: string;
	image?: ImageMetadata;
	dialogId?: string;
};

interface Props {
	items: CardItem[];
	cardLabel: string;
}

const { items, cardLabel } = Astro.props;

const gridClass = items.length === 4 ? "sm:grid-cols-2 lg:grid-cols-4" : "sm:grid-cols-3";
---

<div
	class:list={[
		"-mx-5 flex snap-x gap-3 overflow-x-auto px-5 pb-3 sm:mx-0 sm:grid sm:overflow-visible sm:px-0 sm:pb-0",
		gridClass,
	]}
	aria-label={cardLabel}
>
	{
		items.map(({ title, subtitle, backgroundClass = "bg-leof-burgundy", image, dialogId }) => (
			<article class:list={[
				"group relative flex aspect-4/5 min-w-44 snap-center overflow-hidden rounded-lg text-background-light sm:min-w-0",
				dialogId && "cursor-pointer",
			]}>
				{image ? (
					<Image
						src={image}
						alt=""
						widths={[176, 480]}
						sizes="(max-width: 640px) 176px, 480px"
						format="avif"
						quality={70}
						class:list={[
							"absolute inset-0 h-full w-full object-cover object-[center_30%]",
							dialogId && "transition-transform duration-500 group-hover:scale-105",
						]}
						loading="lazy"
					/>
				) : (
					<div class:list={["absolute inset-0", backgroundClass]} aria-hidden="true" />
				)}
				<div class="absolute inset-0 bg-background-dark/20" aria-hidden="true" />
				<div class="relative z-10 flex h-full w-full flex-col justify-end p-5">
					<h3
						class="program-card-title font-blur text-[clamp(1.75rem,5vw,3rem)] uppercase leading-none"
					>
						{title}
					</h3>
					{subtitle && <p class="mt-2 font-plex text-xs uppercase leading-tight">{subtitle}</p>}
				</div>
				{dialogId && (
					<button
						type="button"
						class="absolute inset-0 z-20 cursor-pointer rounded-lg focus-visible:outline-2 focus-visible:-outline-offset-4 focus-visible:outline-background-light"
						aria-label={`Scopri l'edizione ${title}`}
						data-past-edition-open={dialogId}
					>
						<span class="sr-only">Scopri l'edizione {title}</span>
					</button>
				)}
			</article>
		))
	}
</div>

<script>
	const fitProgramCardTitles = () => {
		const titles = document.querySelectorAll<HTMLElement>(".program-card-title");

		titles.forEach((title) => {
			title.style.fontSize = "";

			const baseSize = Number.parseFloat(window.getComputedStyle(title).fontSize);
			const minSize = baseSize * 0.72;
			let currentSize = baseSize;

			while (title.scrollWidth > title.clientWidth && currentSize > minSize) {
				currentSize -= 1;
				title.style.fontSize = `${currentSize}px`;
			}
		});
	};

	fitProgramCardTitles();
	window.addEventListener("resize", fitProgramCardTitles);
	document.fonts?.ready.then(fitProgramCardTitles);
</script>
